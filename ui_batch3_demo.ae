// =============================================================================
//  第三批功能试玩 —— 组 / 定时器 / 渐变 / 虚线（不会被 run.ps1 当成用例）
//
//  跑法（在 Test 目录下）：
//      ..\Apt\aec.exe ui_batch3_demo.ae
//      ..\Apt\ae.exe ui_batch3_demo.aeo
//      ..\Apt\ae.exe ui_batch3_demo.aeo --auto      ← 自动跑 6 秒然后自己关（自检用）
//
//  该看什么（对应本次更新的每一项）：
//    ① 组 = 容器     那两个"按钮"和卡片都不是库给的控件，是【组】做出来的：
//                    一个圆角矩形 + 一段文字放进组里，改组 = 整块一起动。
//                    鼠标移到按钮上是【整组】放大 —— 组自己带着子图形一起变换。
//    ② 嵌套组        卡片里还嵌了一个组（虚线分隔线 + 里面的按钮）：
//                    外层组的位移/缩放会层层作用到最里面的图形。
//    ③ 事件冒泡      点里面的按钮：按钮先收到，然后冒泡给它所在的组（卡片）、
//                    再到窗口。窗口上也挂了 click —— 所以点空白处也会打日志。
//    ④ 组的裁剪      进度条用【组的裁剪】把填充裁在轨道里：
//                    clip 是相对组自己的，所以整组挪位置时裁剪跟着走。
//    ⑤ 定时器        整个动画没有 while + sleep 循环：三个 ui.timer/ui.tick/
//                    ui.timerOnce 就把"每帧 / 每 250ms / 3 秒后一次"说清了，
//                    ui.run() 里会自动派发（有定时器时它改成轮询 + 睡 1ms）。
//    ⑥ 渐变          一排小方块：水平 / 垂直 / 对角线 / 径向 / 关掉；
//                    按钮底色也是渐变，鼠标移上去换的是 fillColor2。
//    ⑦ 虚线 / 线帽   下面三条线是同一条线配不同 dash/cap/join：
//                    能看出"6 3"的空隙、"round 圆头"多出来的半圆、
//                    "miter 尖角"和"bevel 切角"的区别。
//    ⑧ 转圈          虚线圆环（弧 + dash + round cap）靠【整组旋转】转起来 ——
//                    一条虚线 + 一个 angle 就是常见的 loading 动画。
//    ⑨ Esc 退出窗口（--auto 时 6 秒自己关）
//
//  ★ 关于帧率（第四批的脏矩形 + 离屏缓冲之后重新量的）：
//      · 现在改一个属性只重画它占的那一小块，所以"转圆环 + 推进度条"这种动画
//        每帧只重画几块小区域 —— 这个演示从 40fps 变成 400fps 上下
//      · ui.damage(w) 能看到"上次真正画了几个 / 跳过了几个"（下面第二行文字就是它）
//      · 另外：画进离屏缓冲再 BitBlt 比直接画在窗口 DC 上快一个数量级，
//        相同场景从 54ms/帧降到 3ms/帧
// =============================================================================
imp ui
imp os

// ── 做一个"按钮"：组 + 底 + 文字，返回一张表（组 id 和零件 id 都要用）──
func makeButton(win, x, y, w, h, label, c1, c2) {
    local g  = ui.group(win)
    ui.setAll(g, {x = x, y = y})
    local bg = ui.roundRect(g, 0, 0, w, h, h / 2)
    ui.setAll(bg, {fill = true, fillColor = c1, fillColor2 = c2, gradient = "horizontal",
                   stroke = 0, cursor = "hand"})
    local tx = ui.text(g, w / 2, h / 2, label)
    ui.setAll(tx, {size = 16, color = "#FFFFFF", align = "center", valign = "middle",
                   hits = false, z = 1, cursor = "hand"})
    return {g = g, bg = bg, tx = tx, c1 = c1, c2 = c2}
}

func main() {
    local auto = false
    local av = os.args()
    local ai = 1
    while (ai <= len(av)) {
        if (av[ai] == "--auto") { auto = true }
        ai += 1
    }

    local w = ui.window("Ae 第三批试玩（Esc 退出）", 700, 470)
    if (w == null) { prln("[-] 建窗口失败:", ui.lastError()) return }
    ui.show(w)
    ui.on(w, "keydown", func(e) { if (e.key == 27) { ui.close(w) } })

    local bg = ui.rect(w, 0, 0, 700, 470)
    ui.setAll(bg, {fill = true, fillColor = "#0F172A", stroke = 0, z = -100, aa = false})
    local title = ui.text(w, 24, 22, "第三批：组 / 定时器 / 渐变 / 虚线")
    ui.setAll(title, {size = 20, color = "#E2E8F0", bold = true, z = 5, hits = false})
    local hint = ui.text(w, 676, 28, "Esc 退出")
    ui.setAll(hint, {size = 14, color = "#64748B", align = "right", z = 5, hits = false})

    // ── ① 组做的按钮 + 事件冒泡 ──────────────────────────────────────────
    local b1 = makeButton(w, 30, 70, 210, 46, "点我（组做的按钮）", "#3B82F6", "#8B5CF6")
    local b2 = makeButton(w, 30, 130, 210, 46, "再点一下", "#F59E0B", "#EF4444")
    local clicks = 0
    local cntTxt = ui.text(w, 30, 190, "点了 0 次")
    ui.setAll(cntTxt, {size = 15, color = "#94A3B8", z = 5, hits = false})
    local dmgTxt = ui.text(w, 30, 212, "脏矩形：还没画过")
    ui.setAll(dmgTxt, {size = 13, color = "#475569", z = 5, hits = false})

    // 悬停 = 整组放大 + 换个渐变色
    func hover(b, on) {
        if (on) {
            ui.setAll(b.g, {scale = 1.04})
            ui.set(b.bg, "fillColor2", "#22D3EE")
        } else {
            ui.setAll(b.g, {scale = 1.0})
            ui.set(b.bg, "fillColor2", b.c2)
        }
    }
    ui.on(b1.bg, "mouseenter", func(e) { hover(b1, true) })
    ui.on(b1.bg, "mouseleave", func(e) { hover(b1, false) })
    ui.on(b1.tx, "mouseenter", func(e) { hover(b1, true) })
    ui.on(b1.tx, "mouseleave", func(e) { hover(b1, false) })
    ui.on(b2.bg, "mouseenter", func(e) { hover(b2, true) })
    ui.on(b2.bg, "mouseleave", func(e) { hover(b2, false) })
    ui.on(b2.tx, "mouseenter", func(e) { hover(b2, true) })
    ui.on(b2.tx, "mouseleave", func(e) { hover(b2, false) })

    // 点在【子图形】上，组也会收到（冒泡）—— 打印出来能看到顺序
    ui.on(b1.bg, "click", func(e) { clicks += 1
                                    ui.set(cntTxt, "text", "点了 " + str(clicks) + " 次（按钮收到）") })
    ui.on(b1.g,  "click", func(e) { prln("[事件] 冒泡到按钮所在的组 b1") })
    ui.on(w, "click", func(e) { prln("[事件] 冒泡到窗口:", e.x, e.y, "（点空白处也会打这里）") })

    ui.on(b2.g, "click", func(e) { ui.set(cntTxt, "text", "第二个按钮（事件由【组】自己处理）")
                                   return true })     // ★ 吃掉：不再冒泡到窗口

    // ── ② 嵌套组：卡片里还有一个组 ───────────────────────────────────────
    local card = ui.group(w)
    ui.setAll(card, {x = 30, y = 240})
    local cbg = ui.roundRect(card, 0, 0, 300, 190, 14)
    ui.setAll(cbg, {fill = true, fillColor = "#1E293B", stroke = 1, strokeColor = "#334155",
                    cursor = "hand"})
    local ctitle = ui.text(card, 16, 16, "嵌套组 = 一个卡片")
    ui.setAll(ctitle, {size = 16, color = "#E2E8F0", bold = true, z = 2, hits = false})

    local inner = ui.group(card)                 // ★ 组里套组
    ui.setAll(inner, {x = 16, y = 52})
    local ibg = ui.rect(inner, 0, 0, 268, 74)
    ui.setAll(ibg, {fill = true, fillColor = "#0B1220", stroke = 0, aa = false})
    local d1 = ui.line(inner, 6, 14, 100, 14)
    local d2 = ui.line(inner, 6, 34, 262, 34)
    ui.setAll(d1, {stroke = 2, strokeColor = "#22D3EE", dash = "6 3", aa = true})
    ui.setAll(d2, {stroke = 6, strokeColor = "#334155", dash = "2 6", cap = "round"})
    local ccnt = 0
    local inb = makeButton(inner, 160, 44, 100, 24, "内部按钮", "#10B981", "#059669")
    ui.on(inb.g, "click", func(e) { ccnt += 1
                                    prln("[卡片] 内部按钮第", ccnt, "次（组→卡片→窗口 一路冒泡）") })
    // 卡片上的 click 也会被内部按钮的点击冒泡触发
    ui.on(card, "mouseenter", func(e) { ui.set(card, "scale", 1.02) })
    ui.on(card, "mouseleave", func(e) { ui.set(card, "scale", 1.0) })

    // ── ③ 进度条：用【组的裁剪】把填充裁在轨道里 ─────────────────────────
    local prog = ui.group(w)
    ui.setAll(prog, {x = 360, y = 80, clipX = 0, clipY = 0, clipW = 300, clipH = 20})
    local track = ui.roundRect(prog, 0, 0, 300, 20, 10)
    ui.setAll(track, {fill = true, fillColor = "#1E293B", stroke = 0})
    local fill = ui.roundRect(prog, 0, 0, 300, 20, 10)
    ui.setAll(fill, {fill = true, fillColor = "#22C55E", fillColor2 = "#A3E635",
                     gradient = "horizontal", stroke = 0, z = 1})
    local ptxt = ui.text(w, 510, 110, "0%")
    ui.setAll(ptxt, {size = 15, color = "#CBD5E1", align = "center", z = 5, hits = false})

    // ── ④ 虚线圆环：整组旋转 = loading 动画 ──────────────────────────────
    local spin = ui.group(w)
    ui.setAll(spin, {x = 560, y = 150})
    local ring = ui.path(spin)
    ui.arc(ring, 0, 0, 64, 64, 90, 270)
    ui.setAll(ring, {fill = false, stroke = 7, strokeColor = "#22D3EE",
                     dash = "14 7", cap = "round"})

    // ── ⑤ 虚线 / 线帽 / 线接 对照 ────────────────────────────────────────
    local dashT = ui.text(w, 360, 210, "同一条线，不同 dash / cap / join：")
    ui.setAll(dashT, {size = 15, color = "#94A3B8", z = 5, hits = false})
    local s1 = ui.line(w, 360, 238, 660, 238)
    ui.setAll(s1, {stroke = 3, strokeColor = "#F472B6", dash = "10 6"})
    local s2 = ui.line(w, 360, 256, 660, 256)
    ui.setAll(s2, {stroke = 8, strokeColor = "#FBBF24", dash = "1 1", cap = "round"})
    local s3 = ui.line(w, 360, 274, 660, 274)
    ui.setAll(s3, {stroke = 8, strokeColor = "#38BDF8", dash = "0.5 4", cap = "square"})

    // ── ⑥ 渐变一排 ──────────────────────────────────────────────────────
    local gnames = {"horizontal", "vertical", "diagonal", "radial", ""}
    local glabels = {"水平", "垂直", "对角", "径向", "关闭"}
    local gi = 0
    while (gi < 5) {
        local gx = 360 + gi * 62
        local gr = ui.rect(w, gx, 300, 54, 54)
        ui.setAll(gr, {fill = true, fillColor = "#F43F5E", fillColor2 = "#FDE047",
                       stroke = 0, aa = false})
        if (gnames[gi + 1] != "") { ui.set(gr, "gradient", gnames[gi + 1]) }
        local gl = ui.text(w, gx + 27, 360, glabels[gi + 1])
        ui.setAll(gl, {size = 13, color = "#94A3B8", align = "center", z = 5, hits = false})
        gi += 1
    }

    // ── ⑦ 定时器说明 + 三个定时器 ───────────────────────────────────────
    local tinfo = ui.text(w, 360, 380,
        "这段动画没有任何 while+sleep：\n" +
        "ui.timer(16) 每帧转圆环 + 推进度条\n" +
        "ui.timer(250) 更新这个计数器\n" +
        "ui.timerOnce(3000) 3 秒后换这句提示")
    ui.setAll(tinfo, {size = 14, color = "#64748B", lineGap = 2, z = 5, hits = false})

    // 每帧：转圆环 + 推进度条（% 每帧 +1，到 100 从头来）
    local frames = 0
    local pct = 0
    ui.tick(func(e) {
        frames += 1
        ui.set(spin, "angle", (frames * 4) % 360)
        pct = (frames * 1) % 101
        ui.set(fill, "w", 300 * pct / 100)
        if (pct % 10 == 0) { ui.set(ptxt, "text", str(pct) + "%") }
    })
    // 每 250ms：更新计数器（顺便看看定时器到底跑了多少次 + 脏矩形的效果）
    local ticks = 0
    ui.timer(250, func(e) {
        ticks += 1
        local d = ui.damage(w)
        ui.set(cntTxt, "text", "点了 " + str(clicks) + " 次 | 定时器跑了 " + str(ticks) +
                                " 次 | 帧 " + str(frames))
        ui.set(dmgTxt, "text", "上一帧只重画了 " + str(d.drawn) + " 个图形，跳过了 " +
                                str(d.skipped) + " 个（脏区 " + str(d.w) + "x" + str(d.h) + "）")
    })
    // 3 秒后一次：把提示换成结论
    ui.timerOnce(3000, func(e) {
        ui.set(tinfo, "text", "3 秒到了（timerOnce，只触发一次）。\n" +
                              "定时器全部是脚本驱动的：没有线程，pump/run 里到点才调。")
        ui.set(tinfo, "color", "#22D3EE")
    })

    prln("[+] 开始：窗口数 =", ui.count(), "| 定时器 =", ui.timers())
    if (auto) {
        ui.timerOnce(6000, func(e) { prln("[自动] 6 秒到，关窗"); ui.close(w) })
        prln("[自动模式] 6 秒后自己关")
    }

    // ★ 主循环交给库：ui.run() 会一直派发事件 + 定时器，直到窗口关掉
    ui.run(w)
    prln("[+] 退出：跑了", frames, "帧，定时器回调", ticks, "次，按钮被点", clicks, "次")
}
