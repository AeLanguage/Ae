// =============================================================================
//  鼠标移动时的帧率检查 —— 配合 Test/check_mouse.ps1
// -----------------------------------------------------------------------------
//  用户报的 bug①：鼠标在窗口里移动时，所有动画都掉到 30fps 上下。
//  原因：每来一条 WM_MOUSEMOVE，命中测试都会把【每个图形】都真的建一次路径 +
//  Widen 判一遍 —— 800 个图形上一条 mousemove 要 31ms（= 30fps）。
//  修法：先用缓存的包围盒粗筛（见 collectHits 里的 itemParentBounds），
//  只有包围盒沾到点的才做精细判定。
//
//  这里不猜，直接量：每 500ms 打一行累计帧数，PowerShell 在中间那段时间
//  往窗口猛投 WM_MOUSEMOVE，然后比较"灌鼠标之前/之中/之后"每段的帧数。
// =============================================================================
imp ui
imp os

func main() {
    local w = ui.window("MOUSEFLOOD", 660, 470)
    if (w == null) { prln("[-] 建窗口失败:", ui.lastError()) return }
    ui.show(w)

    local bg = ui.rect(w, 0, 0, 660, 470)
    ui.setAll(bg, {fill = true, fillColor = "#FFFFFF", stroke = 0, z = -100, aa = false})
    local n = 0
    local first = 0
    while (n < 800) {
        local r = ui.rect(w, 240 + (n % 40) * 10, 30 + (n / 40) * 21, 8, 8)
        ui.setAll(r, {fill = true, fillColor = "#334155", stroke = 0, z = -50, aa = false})
        if (n == 0) { first = r }
        n += 1
    }
    local ball = ui.circle(w, 40, 400, 14)
    ui.setAll(ball, {fill = true, fillColor = "#22C55E", stroke = 0})

    local frames = 0
    local last = os.millis()
    local maxGap = 0
    ui.tick(func(e) {
        frames += 1
        ui.set(ball, "x", 40 + (frames % 200))
        local now = os.millis()
        local gap = now - last
        if (gap > maxGap) { maxGap = gap }
        last = now
    })

    // 每 500ms 报一次累计帧数（PowerShell 靠这些数比较各段的速度）
    ui.timer(500, func(e) { prln("[帧] " + str(os.millis()) + " " + str(frames)) })

    ui.timerOnce(6000, func(e) {
        prln("[结果] 总帧数 =", frames, "| 最大帧间隔 =", maxGap, "ms")
        ui.close(w)
    })

    prln("[就绪] 800 个图形 + 动画")
    ui.run(w)
}
