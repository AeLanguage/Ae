// check_run.ps1 的主程序：把内置函数 run 的各种语义都过一遍
// 说明：父程序的输出会带 [1]…[9] 前缀，脚本按这些标记做断言
imp os
imp ui

// 自我递归用：被 run("runmain.aeo") 调起来时只递归、不打印（免得刷屏）
func deepOnly() {
    run("runmain.aeo", {"deep"})
}

func main() {
    local myArgs = os.args()
    if (len(myArgs) >= 1 and myArgs[1] == "deep") {
        deepOnly()                      // 一路递归到嵌套上限
        return
    }
    g = 7                               // 父程序的全局（下面验证子程序改不到它）

    // ① 最基本的：a 跑 b，b 跑完回到 a
    prln("[0] 父程序开始（这行之后应该先看到子程序的输出，再看到 [1]）")
    prln("[1] 子程序返回 =", run("child.aeo"))

    // ② 顺序：子程序的输出必须夹在父程序两条输出之间
    prln("[2] 顺序检查：上面是子程序、这条是父程序")

    // ③ 隔离：子程序看不见也改不到父程序的全局
    prln("[3] 父程序全局 g =", g)

    // ④ 传参：第 2 个参数是字符串数组，子程序里 os.args() 能看到
    prln("[4] 带参数返回 =", run("child.aeo", {"pass", "第二个参数"}))

    // ⑤ 子程序 exit(3) → run 的返回值就是 3（不结束父程序）
    prln("[5] exit 码 =", run("child.aeo", {"exit"}))

    // ⑥ 子程序里未捕获的错误 → 父程序这边可以 catch，码沿用子程序的
    try {
        run("child.aeo", {"fail"})
        prln("[6] 不该到这里")
    } catch (e) {
        prln("[6] 捕获 code =", e.code)
        prln("[6] 消息里有子程序位置 =", e.msg)
    }

    // ⑦ 找不到文件：E0002
    try {
        run("肯定没有这个文件.aeo")
    } catch (e) {
        prln("[7] 找不到文件 code =", e.code)
    }

    // ⑧ 三层嵌套：a → child → child2
    prln("[8] 嵌套返回 =", run("child.aeo", {"nest", "x"}))

    // ⑨ ui 子程序：窗口/定时器在它结束时就该被清掉，父程序自己照常工作
    prln("[9] ui 前 count =", ui.count())
    run("uichild.aeo")
    prln("[9] ui 后 count =", ui.count())
    local w = ui.window("父的窗口", 200, 120)
    local hit = 0
    ui.on(w, "click", func(e) { hit += 1 })
    ui.send(w, "click", {x = 5, y = 5})
    ui.pump()
    prln("[9] 父程序回调仍然工作 =", hit == 1)

    // ⑩ 父程序自己开着窗口的时候跑 ui 子程序：子程序收尾只能清它自己的窗口，
    //    父程序的窗口必须留着、回调照常（closeAll 是按 VM 归属清的）
    prln("[10] 跑子程序前 父窗口在 =", ui.count() == 1, "count =", ui.count())
    run("uichild.aeo")
    prln("[10] 跑完子程序 父窗口在 =", ui.count() == 1, "count =", ui.count())
    hit = 0
    ui.send(w, "click", {x = 7, y = 7})
    ui.pump()
    prln("[10] 父程序回调仍然工作 =", hit == 1)
    ui.close(w)
    prln("[10] 收尾 count =", ui.count())

    // ⑪ 自我递归：run 的嵌套上限拦住它（错误码 E2006）
    try {
        run("runmain.aeo", {"deep"})
        prln("[11] 不该到这里")
    } catch (e) {
        prln("[11] 嵌套上限 code =", e.code)
        prln("[11] 提示 =", e.msg)
    }

    prln("[done] 全部检查跑完")
}
