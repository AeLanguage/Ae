// 事件回调里出错 → 按约定当场中断（带调用栈），不是静默忽略
imp ui

func main() {
    local w = ui.window("回调出错", 100, 80)
    local box = ui.rect(w, 0, 0, 50, 50)
    ui.on(box, "click", func(e) {
        local bad = null
        return bad + 1        // 对 null 做加法 → 运行错误
    })
    ui.send(w, "click", {x = 10, y = 10})
    ui.pump()
    prln("这行不该被执行")
}