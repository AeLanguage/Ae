// P0-4 验收：bool 不再是数值
func main() {
    prln("1) bool 是独立类型   :", type(true), type(false), type(1))
    prln("2) bool 判等         :", true == true, true == false)
    prln("3) bool 与 int 不相等:", true == 1, false == 0)
    prln("4) 显式转换可用      :", int(true), int(false), int(true) + 1, float(true) * 3.0)
    prln("5) str(bool)         :", str(true), str(false))
    prln("6) 真值判断          :", true, false)
    prln("7) 转换后参与算术    :", int(true) * 10 + int(false), int(true) + int(true))
}
