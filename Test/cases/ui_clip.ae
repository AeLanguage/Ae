// =============================================================================
//  第一批新增能力验收：裁剪 / 光标形状 / 修饰键+时间戳+键名 / 命中测试细节
// -----------------------------------------------------------------------------
//  判定方式：ui.pixel 看像素 + ui.send 造事件走真实派发路径。
// =============================================================================
imp ui

func main() {
    local w = ui.window("裁剪与事件", 240, 180)
    local bg = ui.rect(w, 0, 0, 240, 180)
    ui.setAll(bg, {fill = true, fillColor = "#101010", stroke = 0, z = -10})

    // ── 1) 裁剪：大矩形只显示被裁出来的那一小块 ──
    local big = ui.rect(w, 20, 20, 200, 140)
    ui.setAll(big, {fill = true, fillColor = "#FF0000", stroke = 0,
                    clipX = 20, clipY = 20, clipW = 60, clipH = 40})
    prln("1) 裁剪区内有颜色 =", ui.pixel(w, 40, 40) == 0xFF0000,
         "| 裁剪区外是背景 =", ui.pixel(w, 120, 100) == 0x101010)

    // ── 2) 挪裁剪区 = 滚动视图的做法 ──
    ui.setAll(big, {clipX = 100, clipY = 100})
    prln("2) 挪走后原处变空 =", ui.pixel(w, 40, 40) == 0x101010,
         "| 新位置有颜色 =", ui.pixel(w, 120, 120) == 0xFF0000)

    // ── 3) 裁剪同样约束命中：被裁掉的部分点不到 ──
    local clipped = 0
    ui.on(big, "click", func(e) { clipped += 1 })
    ui.send(w, "click", {x = 120, y = 120})      // 裁剪区内
    ui.pump()
    ui.send(w, "click", {x = 40, y = 40})        // 图形范围内，但被裁掉了
    ui.pump()
    prln("3) 裁剪区内命中一次 =", clipped == 1, "| 裁掉的部分点不到 =", clipped == 1)

    // ── 4) 空心矩形：整个矩形都能点（所见即所点，UI 里更好用）──
    local hollow = ui.rect(w, 150, 20, 70, 50)
    ui.setAll(hollow, {fill = false, stroke = 2, strokeColor = "#00FF00", z = 5})
    local hh = 0
    ui.on(hollow, "click", func(e) { hh += 1 })
    ui.send(w, "click", {x = 185, y = 45})
    ui.pump()
    prln("4) 空心矩形内部也能点 =", hh == 1)

    // ── 5) 细线按"轮廓 + 容差"命中（和画笔手感一致）──
    local ln = ui.line(w, 20, 170, 200, 170)
    ui.setAll(ln, {stroke = 2, strokeColor = "#FFFF00", z = 6})
    local lh = 0
    ui.on(ln, "click", func(e) { lh += 1 })
    ui.send(w, "click", {x = 100, y = 173})      // 线附近（3px）
    ui.pump()
    ui.send(w, "click", {x = 100, y = 60})       // 远离
    ui.pump()
    prln("5) 线附近命中 =", lh == 1, "| 远处不命中 =", lh == 1)

    // ── 6) 鼠标形状：图形上一个、窗口一个默认 ──
    ui.set(hollow, "cursor", "hand")
    ui.set(w, "cursor", "cross")
    prln("6) 光标: 图形 =", ui.get(hollow, "cursor"), "| 窗口 =", ui.get(w, "cursor"))

    // ── 7) 修饰键 + 时间戳 ──
    local seen = ""
    ui.on(w, "click", func(e) { seen = "shift=" + str(e.shift) + " ctrl=" + str(e.ctrl) +
                                       " alt=" + str(e.alt) + " 时间戳是整数=" + str(e.time >= 0) })
    ui.send(w, "click", {x = 5, y = 5, shift = true, ctrl = true})
    ui.pump()
    prln("7) 修饰键与时间戳:", seen)

    // ── 8) 可读键名 ──
    local kn = ""
    ui.on(w, "keydown", func(e) { kn = e.keyName + "(" + str(e.key) + ")" })
    ui.send(w, "keydown", {key = 13})
    ui.pump()
    prln("8) Enter =", kn)
    ui.send(w, "keydown", {key = 37})
    ui.pump()
    prln("9) Left =", kn)

    // ── 9) 错误路径（写错要明确报错，不静默）──
    local r2 = ui.rect(w, 0, 0, 10, 10)
    local p2 = ui.path(w)
    try { ui.lineTo(r2, 1, 2) } catch (e) { prln("10) 非路径对象:", e.msg) }
    try { ui.set(p2, "cmds", {1, 2, 3, 9, 4, 5}) } catch (e) { prln("11) 坏操作码:", e.msg) }
    try { ui.set(p2, "cmds", {1, 2, 3, 4}) } catch (e) { prln("12) 指令截断:", e.msg) }
    try { ui.set(r2, "cmds", {1, 2, 3}) } catch (e) { prln("13) 矩形没有 cmds:", e.msg) }
    try { ui.get(p2, "points") } catch (e) { prln("14) path 没有 points:", e.msg) }

    prln("15) 收尾: 窗口数 =", ui.count(), "| lastError =", ui.lastError())
    ui.close(w)
}
