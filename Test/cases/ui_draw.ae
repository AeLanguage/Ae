// =============================================================================
//  ui 绘制层验收：点线面 / 空心实心 / 描边 / 线宽 / 圆角 / 层级 / 属性读写
// -----------------------------------------------------------------------------
//  判定方式：ui.pixel(win, x, y) 离屏重画一遍再取色 → 断言真实像素。
//  所以这个用例【不需要 show】，屏幕上不会闪窗口。
//  背景色 = 系统窗口底色（COLOR_WINDOW），下面用 bg 表示。
// =============================================================================
imp ui

func main() {
    local w = ui.window("绘制验收", 200, 200)
    local bg = ui.pixel(w, 199, 199)          // 空窗口的背景色
    prln("背景色 =", bg)

    // ── 1) 实心矩形 ──
    local r = ui.rect(w, 10, 10, 60, 60)
    prln("默认 fill =", ui.get(r, "fill"), "| 默认 stroke =", ui.get(r, "stroke"))
    prln("空心矩形：内部是空的", ui.pixel(w, 40, 40) == bg,
         "| 边上默认已有 1px 描边", ui.pixel(w, 10, 40) != bg)

    ui.setAll(r, {fill = true, fillColor = "#FF0000", stroke = 0})
    prln("实心红：内部", ui.pixel(w, 40, 40) == 0xFF0000, "| 外部",
         ui.pixel(w, 100, 40) == bg)

    // ── 2) 颜色写法 ──
    prln("get 颜色 =", ui.get(r, "fillColor"))
    ui.set(r, "fillColor", 0x0000FF)          // 整数形式
    prln("整数设色后 =", ui.get(r, "fillColor"), "| 像素",
         ui.pixel(w, 40, 40) == 0x0000FF)
    ui.set(r, "fillColor", "#0f0")            // #RGB 简写
    prln("#RGB 简写 =", ui.get(r, "fillColor"), "| 像素",
         ui.pixel(w, 40, 40) == 0x00FF00)

    // ── 3) 描边 / 线宽 ──
    ui.setAll(r, {fill = false, stroke = 4, strokeColor = "#000000"})
    prln("4px 描边：上边(40,10)", ui.pixel(w, 40, 10) == 0x000000,
         "| 内部仍是空的", ui.pixel(w, 40, 40) == bg)
    ui.set(r, "stroke", 0)
    prln("stroke=0 时完全不画：", ui.pixel(w, 40, 10) == bg)
    ui.remove(r)
    prln("remove 后：", ui.pixel(w, 40, 10) == bg)

    // ── 4) 圆 / 椭圆（空心 / 实心）──
    local c = ui.circle(w, 100, 100, 40)
    ui.setAll(c, {fill = true, fillColor = "#123456", stroke = 0})
    prln("实心圆：圆心", ui.pixel(w, 100, 100) == 0x123456,
         "| 外接框角上", ui.pixel(w, 62, 62) == bg)
    ui.set(c, "fill", false)
    prln("改空心（实时变换）：圆心", ui.pixel(w, 100, 100) == bg)
    ui.set(c, "fill", true)

    local e = ui.ellipse(w, 100, 100, 30, 10)
    ui.setAll(e, {fill = true, fillColor = "#7700FF", stroke = 0, z = 5})
    prln("椭圆：中央", ui.pixel(w, 100, 100) == 0x7700FF, "| 上下超出（也避开圆）",
         ui.pixel(w, 100, 55) == bg)

    // ── 5) 多边形（面 / 折线）──
    ui.remove(e)
    local tri = ui.poly(w, {0, 0, 80, 0, 0, 80})
    ui.setAll(tri, {x = 10, y = 110, fill = true, fillColor = "#FFAA00", stroke = 0})
    prln("实心三角：内部", ui.pixel(w, 30, 130) == 0xFFAA00,
         "| 斜边外", ui.pixel(w, 80, 180) == bg)
    ui.set(tri, "closed", false)
    prln("改折线（不闭合）：内部", ui.pixel(w, 30, 130) == bg)
    ui.set(tri, "closed", true)
    prln("points 读写 = 长度", len(ui.get(tri, "points")), "第 3 个", ui.get(tri, "points")[3])

    // ── 6) 独立圆角 ──
    ui.remove(tri)
    local rr = ui.roundRect(w, 20, 20, 120, 60, 15)
    ui.setAll(rr, {fill = true, fillColor = "#00AAFF", stroke = 0})
    prln("统一圆角 15：左上角(22,22)", ui.pixel(w, 22, 22) == bg,
         "| 中心", ui.pixel(w, 80, 50) == 0x00AAFF)
    ui.setAll(rr, {r = 0, rtl = 20})           // 只圆左上角
    prln("只圆左上：左上", ui.pixel(w, 22, 22) == bg,
         "| 右上", ui.pixel(w, 138, 22) == 0x00AAFF)
    ui.setAll(rr, {rtl = 0, rtr = 20})
    prln("只圆右上：左上", ui.pixel(w, 22, 22) == 0x00AAFF,
         "| 右上", ui.pixel(w, 138, 22) == bg)
    ui.setAll(rr, {rtr = 0, rbr = 20})
    prln("只圆右下：右下", ui.pixel(w, 138, 78) == bg)
    ui.setAll(rr, {rbr = 0, rbl = 20})
    prln("只圆左下：左下", ui.pixel(w, 22, 78) == bg)
    ui.remove(rr)

    // ── 7) 层级（z）──
    local a = ui.rect(w, 0, 0, 100, 100)
    ui.setAll(a, {fill = true, fillColor = "#FF0000", stroke = 0, z = 0})
    local b = ui.rect(w, 0, 0, 100, 100)
    ui.setAll(b, {fill = true, fillColor = "#0000FF", stroke = 0, z = 1})
    prln("同位置两矩形：上层是蓝", ui.pixel(w, 50, 50) == 0x0000FF)
    ui.set(b, "z", -1)                          // 实时改层级
    prln("把蓝的 z 改到下面：", ui.pixel(w, 50, 50) == 0xFF0000)
    ui.set(b, "visible", false)
    prln("隐藏蓝的：", ui.pixel(w, 50, 50) == 0xFF0000)
    ui.set(b, "visible", true)

    // ── 8) 点 / 线 ──
    ui.setAll(a, {visible = false, })
    ui.set(b, "visible", false)
    local p = ui.point(w, 20, 20)
    prln("点默认实心 r=2：", ui.pixel(w, 20, 20) == 0x000000)
    ui.setAll(p, {r = 6, fillColor = "#FF00FF"})
    prln("点变 r=6 洋红：", ui.pixel(w, 20, 20) == 0xFF00FF)
    ui.remove(p)

    local l = ui.line(w, 10, 190, 190, 190)
    ui.setAll(l, {stroke = 20, strokeColor = "#00FF00"})
    prln("20px 粗线：线上", ui.pixel(w, 100, 190) == 0x00FF00,
         "| 线外", ui.pixel(w, 100, 150) == bg)
    ui.set(l, "stroke", 0)
    prln("线宽改 0 后不画：", ui.pixel(w, 100, 190) == bg)

    // ── 9) 抗锯齿：沿斜线边缘采样，开/关必须给出不同的像素 ──
    local d1 = ui.line(w, 10, 10, 190, 190)
    ui.setAll(d1, {stroke = 6, strokeColor = "#000000", aa = true})
    local on = {}
    local i = 0
    while (i < 9) { on[i + 1] = ui.pixel(w, 100, 92 + i)  i += 1 }
    ui.set(d1, "aa", false)
    local diff = 0
    i = 0
    while (i < 9) {
        if (ui.pixel(w, 100, 92 + i) != on[i + 1]) { diff += 1 }
        i += 1
    }
    prln("抗锯齿开/关在边缘有", diff, "个像素不同（应 > 0）")
    ui.remove(d1)
    ui.remove(l)

    // ── 10) 属性总览 / 窗口属性 ──
    local s = ui.rect(w, 5, 5, 30, 30)
    local pr = ui.props(s)
    prln("props.kind =", pr.kind, "| x =", pr.x, "| fill =", pr.fill,
         "| win =", pr.win == w, "| z =", pr.z)
    prln("get 返回整数不是浮点 =", ui.get(s, "x") == 5)
    ui.setAll(s, {x = 7.5, y = 8.25})
    prln("浮点也能设：x =", ui.get(s, "x"), "| y =", ui.get(s, "y"))
    prln("shapes 列表长度 =", len(ui.shapes(w)), "| count =", ui.count())
    ui.clear(w)
    prln("clear 后图形数 =", len(ui.shapes(w)))
    prln("clear 后用旧 id：")
    try { ui.get(s, "x") } catch (e) { prln("  [-] " + e.msg) }

    prln("窗口属性: set 标题 / get 标题 =", ui.set(w, "title", "新标题") == w,
         ui.get(w, "title"))
    prln("窗口 props.kind =", ui.props(w).kind, "| visible =", ui.props(w).visible)

    // ── 11) 错误路径 ──
    local t = ui.rect(w, 0, 0, 10, 10)
    try { ui.set(t, "nope", 1) } catch (e) { prln("[-] " + e.msg) }
    try { ui.get(t, "nope") } catch (e) { prln("[-] " + e.msg) }
    try { ui.set(t, "fillColor", "red") } catch (e) { prln("[-] " + e.msg) }
    try { ui.circle(t, 0, 0, 5) } catch (e) { prln("[-] " + e.msg) }
    try { ui.poly(w, {1, 2, 3}) } catch (e) { prln("[-] " + e.msg) }
    try { ui.set(w, "stroke", 3) } catch (e) { prln("[-] " + e.msg) }
    prln("窗口外取色 =", ui.pixel(w, 999, 999))
    prln("lastError =", ui.lastError())
    ui.close(w)
    prln("关窗后 count =", ui.count())
}
