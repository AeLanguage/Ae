// P2 验收：语法与语义
func main() {
    prln("── P2-3 数字字面量 ──")
    prln("hex 0xFF =", 0xFF, "| 0x10 =", 0x10, "| 二进制 0b1011 =", 0b1011)
    prln("分隔符 1_000_000 =", 1_000_000, "| 0xFF_FF =", 0xFF_FF)
    prln("科学计数法 1e3 =", 1e3, "| 1.5e-2 =", 1.5e-2, "| 2E2 =", 2E2)

    prln("── P2-1 位运算 ──")
    prln("6 & 3 =", 6 & 3, "| 6 | 3 =", 6 | 3, "| 6 ^ 3 =", 6 ^ 3)
    prln("~0 =", ~0, "| ~5 =", ~5)
    prln("1 << 10 =", 1 << 10, "| 1024 >> 3 =", 1024 >> 3, "| -8 >> 1 =", -8 >> 1)
    prln("优先级 (6 & 3) == 2 →", 6 & 3 == 2)
    prln("十六进制位掩码 0xF0 | 0x0F =", 0xF0 | 0x0F, "= 0xFF ?", (0xF0 | 0x0F) == 0xFF)

    prln("── P2-2 幂 ──")
    prln("2 ** 10 =", 2 ** 10, "| 2 ** 0 =", 2 ** 0)
    prln("右结合 2 ** 3 ** 2 =", 2 ** 3 ** 2, "(=512)")
    prln("-2 ** 2 =", -2 ** 2, "(=-4，幂比一元负号紧)")
    prln("2.0 ** 0.5 =", 2.0 ** 0.5, "| 2 ** -1 =", 2 ** -1)

    prln("── P2-10 负数除模（向下取整）──")
    prln("-7 / 3 =", -7 / 3, "| -7 % 3 =", -7 % 3, "(期望 -3 / 2)")
    prln("7 / -3 =", 7 / -3, "| 7 % -3 =", 7 % -3, "(期望 -3 / -2)")
    prln("7 / 3 =", 7 / 3, "| 7 % 3 =", 7 % 3)

    prln("── P2-9 浮点格式（最短往返）──")
    prln("1.0/3.0 =", 1.0 / 3.0)
    prln("0.1+0.2 =", 0.1 + 0.2)
    prln("2.0 =", 2.0, "| 3000000000 + 0.5 =", 3000000000 + 0.5)
    prln("str 与 prln 一致:", str(1.0 / 3.0) == str(1.0 / 3.0))

    prln("── P2-6 转义 ──")
    prln("\\x41\\x42 =", "AB", "| \\u4e2d\\u6587 =", "中文", "| \\a\\b\\f\\v 长度 =", len("x"))

    prln("── P2-4 do/while ──")
    local n = 0
    do {
        n += 1
    } while (n < 3)
    prln("do/while 至少执行一次，n =", n)

    local m = 10
    do {
        m += 1
    } while (false)
    prln("条件为假也执行一次，m =", m)

    prln("── P2-5 break N / continue N ──")
    local hits = ""
    for i = 1, 3 {
        for j = 1, 3 {
            if (j == 2) { continue 1 }
            if (i == 3) { break 2 }
            hits += str(i) + str(j) + " "
        }
    }
    prln("嵌套控制:", hits, "(期望 11 13 21 23)")

    prln("── P2-7 块注释 ──")
    /* 这是一段
       多行块注释 */
    prln("块注释之后仍正常:", 1 + 1)
}
