// ui 库：窗口创建 / 标题 / 大小 / 位置 / 缩放标志 / 关闭 / 错误路径
// ⚠ 这个用例会真的在屏幕上闪一下窗口（创建后立刻关闭），并且是 DPI 感知的
//    （尺寸/坐标都是真实像素）。帧尺寸（winW/winH）随 DPI 变，所以不打印。
imp ui

func main() {
    local id = ui.window("Ae UI 测试", 400, 300)
    prln("创建成功 =", id > 0, "| lastError =", ui.lastError())

    local i = ui.info(id)
    prln("客户区 =", i.w, "x", i.h, "| visible =", i.visible,
         "| resizable =", i.resizable, "| maximizable =", i.maximizable)

    ui.show(id)
    prln("show 后 visible =", ui.visible(id), "| pump =", ui.pump())

    ui.title(id, "改名：中文标题")
    prln("titleOf =", ui.titleOf(id))

    ui.size(id, 640, 480)
    local s = ui.info(id)
    prln("size(640,480) 后 =", s.w, "x", s.h)

    ui.pos(id, 100, 120)
    local p = ui.info(id)
    prln("pos(100,120) 后 =", p.x, ",", p.y)

    ui.resizable(id, false)
    ui.maximizable(id, false)
    local f = ui.info(id)
    prln("两个标志关掉 =", f.resizable, f.maximizable)

    ui.resizable(id, true)
    ui.maximizable(id, true)
    local g = ui.info(id)
    prln("两个标志打开 =", g.resizable, g.maximizable)

    prln("count =", ui.count())
    ui.close(id)
    prln("close 后 count =", ui.count(), "| pump =", ui.pump())

    // 尺寸非法：预期失败 → null + lastError（不抛）
    prln("window(0,0) =", ui.window("x", 0, 0), "|", ui.lastError())

    // 程序性错误：抛运行错误
    try { ui.title(id, "x") } catch (e) { prln("[-]", e.msg) }
    try { ui.visible(999) } catch (e) { prln("[-]", e.msg) }
    try { ui.window("t", "宽", 300) } catch (e) { prln("[-]", e.msg) }

    local id2 = ui.window("第二个", 200, 150)
    try { ui.resizable(id2, "是") } catch (e) { prln("[-]", e.msg) }
    ui.close(id2)

    // 没有窗口时 run(0) 立刻返回（不会卡住）
    prln("run(0) 无窗口 =", ui.run(0))
}
