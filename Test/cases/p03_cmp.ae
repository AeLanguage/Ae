// P0-3 验收：判等与大小比较的新语义（本文件全部是合法写法）
func main() {
    prln("1) 同类型判等      :", 1 == 1, 2 != 3, "a" == "a", "a" != "b")
    prln("2) bool 判等       :", true == true, true == false, true != false)
    prln("3) null 判等       :", null == null, null != null)
    prln("4) 与 null 比较合法:", null == 1, 1 == null, "s" == null, {1} == null, null != 1)
    prln("5) 不同范畴判等    :", true == 1, 1 == "a", "1" == 1)
    prln("6) null == false   :", null == false)

    local f = 1.5
    prln("7) 整数大小比较    :", 1 < 2, 2 <= 2, 3 > 1, 3 >= 4)
    prln("8) 浮点同类型比较  :", f > 1.0, f < 2.0, f == 1.5)
    prln("9) 字符串字典序    :", "a" < "b", "b" <= "a", "abc" > "ab")
    prln("10) bool 大小比较  :", true > false, false < true)

    local t = {1}
    local u = {1}
    prln("11) 表按引用身份   :", t == t, t == u, t != u)

    prln("12) 算术仍自动提升 :", 1 + 1.5, f + 1, 2 * f)
    prln("13) 显式统一后可比较:", float(1) == 1.0, f > float(1))
}
