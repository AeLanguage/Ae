// P0-2 验收：int64 常量
func main() {
    prln("1) 3000000000            :", 3000000000)
    prln("2) 2147483648 (INT32_MAX+1):", 2147483648)
    prln("3) INT64_MAX             :", 9223372036854775807)
    prln("4) 负数大整数            :", 0 - 2147483648)
    prln("5) 大整数加法            :", 3000000000 + 3000000000)
    prln("6) 大整数乘法            :", 3000000000 * 3)
    prln("7) type 仍为 int         :", type(3000000000), type(3000000000 + 1))
    prln("8) 大整数除法            :", 9223372036854775807 / 3000000000)
    prln("9) 大整数比较            :", 3000000000 < 4000000000, 3000000000 == 3000000000)
    prln("10) 混合 int/float 算术  :", 3000000000 + 0.5)
}
