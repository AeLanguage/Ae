// 错误捕获（try/catch）与表字段点号访问 —— 验收
imp io

func riskyDiv(n) {
    return 100 / n
}

func throwsType() {
    local f = 1.5
    return f > 1                      // 跨类型比较 → E2001
}

func main() {
    prln("── 1) 捕获除零，看错误表字段 ──")
    try {
        prln(riskyDiv(0))
    } catch (e) {
        prln("code =", e.code, "| kind =", e.kind)
        prln("msg  =", e.msg)
        prln("位置 = 第", e.line, "行 第", e.col, "列")
        prln("file 非空 =", len(e.file) > 0, "| stack 非空 =", len(e.stack) > 0)
    }

    prln("── 2) 捕获类型错误 ──")
    try { throwsType() } catch (e) { prln("code =", e.code, "| kind =", e.kind) }

    prln("── 3) 捕获索引/非表错误 ──")
    try {
        local t = 5
        prln(t[1])
    } catch (e) { prln("code =", e.code, "| kind =", e.kind) }

    prln("── 4) 捕获原生库报错 ──")
    try {
        prln(io.readFile(123))
    } catch (e) { prln("code =", e.code, "| kind =", e.kind) }

    prln("── 5) assert 与 error() ──")
    try { assert(false, "自定义断言") } catch (e) { prln("code =", e.code, "| kind =", e.kind, "|", e.msg) }
    try { error("我主动报错") } catch (e) { prln("code =", e.code, "| kind =", e.kind, "|", e.msg) }

    prln("── 6) 嵌套 try + raise(e) 重抛 ──")
    try {
        try {
            prln(1 / 0)
        } catch (inner) {
            prln("  内层捕获:", inner.code)
            raise(inner)
        }
    } catch (outer) {
        prln("  外层捕获:", outer.code, "| kind =", outer.kind)
    }

    prln("── 7) 出错后程序继续跑，状态没坏 ──")
    local sum = 0
    for i = 1, 5 {
        try {
            if (i == 3) { error("第 3 个故意失败") }
            sum += i
        } catch (e) { prln("  第", i, "个被跳过") }
    }
    prln("sum =", sum, "（期望 12）")

    prln("── 8) 表字段点号访问（e.code 就是靠它）──")
    local cfg = {name = "Ae", version = 2, nested = {ok = true}}
    prln("cfg.name =", cfg.name, "| cfg.version =", cfg.version)
    prln("链式 cfg.nested.ok =", cfg.nested.ok)
    prln("与下标等价 =", cfg.nested["ok"] == cfg.nested.ok)
    prln("不存在的字段 =", cfg.missing)
    cfg.version = 3
    prln("字段赋值后 cfg.version =", cfg.version, "| 等价 cfg[\"version\"] =", cfg["version"])

    prln("── 9) break 跳出带 try 的循环后仍能正常捕获 ──")
    local k = 0
    while (k < 3) {
        k += 1
        try {
            if (k == 2) { break }
        } catch (e) { prln("不该到这里") }
    }
    prln("break 出 try 正常，k =", k)
    try { error("跳出循环后仍能捕获") } catch (e) { prln("仍可捕获 =", e.kind) }

    prln("── 10) return 穿过 try 后仍能正常捕获 ──")
    prln("穿过 try 的返回值 =", returnThroughTry())
    try { error("return 之后仍能捕获") } catch (e) { prln("仍可捕获 =", e.kind) }
}

func returnThroughTry() {
    try {
        return 42
    } catch (e) {
        return -1
    }
}
