// path 库验收 + 与 io 联手做递归目录遍历
imp path
imp io

func main() {
    prln("═══ 纯字符串运算（与平台无关：规范分隔符一律 /）═══")
    prln("── 查询 ──")
    prln("sep 合法 =", path.sep() == "/" or path.sep() == "\\")
    prln("isAbsolute:", path.isAbsolute("/a/b"), path.isAbsolute("C:/a"), path.isAbsolute("a/b"), path.isAbsolute("./a"))

    prln("── 拆解 ──")
    local p = "/home/user/docs/a.tar.gz"
    prln("dirname  =", path.dirname(p))
    prln("basename =", path.basename(p))
    prln("stem     =", path.stem(p))
    prln("ext      =", path.ext(p))
    prln("边界: dirname(\"a.txt\") = [" + path.dirname("a.txt") + "]  basename(\"a/b/\") = " + path.basename("a/b/"))
    prln("隐藏文件: stem(\".gitignore\") = " + path.stem(".gitignore") + "  ext = [" + path.ext(".gitignore") + "]")
    prln("盘符: dirname(\"C:/a\") = " + path.dirname("C:/a") + "  dirname(\"/a\") = " + path.dirname("/a"))
    prln("split =", path.split("/home//user/./docs/"))

    prln("── 组装 ──")
    prln("join(3段)     =", path.join("a", "b", "c"))
    prln("join 带 ..    =", path.join("a/b", "..", "c"))
    prln("join 遇绝对    =", path.join("a", "/x", "y"))
    prln("join 反斜杠    =", path.join("a\\b", "c"))
    prln("join 忽略空串  =", path.join("a", "", "b"))

    prln("── 规范化 ──")
    prln("normalize =", path.normalize("a//b/./c/../d"))
    prln("越过根被吃掉 =", path.normalize("/../a"))
    prln("相对路径保留 .. =", path.normalize("../a"))
    prln("空串 → . =", path.normalize(""))
    prln("replaceExt(.md) =", path.replaceExt("dir/a.txt", "md"))
    prln("replaceExt(空)  =", path.replaceExt("dir/a.txt", ""))
    prln("toNative 长度 =", len(path.toNative("a/b/c")))

    prln("── abs ──")
    prln("abs 结果绝对 =", path.isAbsolute(path.abs("x.txt")))
    prln("abs 幂等 =", path.abs("x.txt") == path.abs("x.txt"))
    prln("abs 已绝对保持 =", path.abs("/tmp/x") == "/tmp/x")
    prln("abs 规范化相对 =", path.isAbsolute(path.abs("./a/../b.txt")))

    // ═══ 与 io 联手：建一棵小目录树，然后递归列出来 ═══
    prln("")
    prln("═══ path + io：递归目录遍历 ═══")
    local root = "path_scratch"
    io.remove(root)
    io.mkdir(path.join(root, "sub"))
    io.mkdir(path.join(root, "sub", "deep"))
    io.writeFile(path.join(root, "a.txt"), "a")
    io.writeFile(path.join(root, "sub", "b.txt"), "b")
    io.writeFile(path.join(root, "sub", "deep", "c.md"), "c")

    walk(root, root, 0)

    prln("")
    prln("── 顺手演示：按扩展名筛选 ──")
    local all = collectFiles(root, root, {})
    local txt = 0
    local md = 0
    local i = 1
    while (i <= len(all)) {
        if (path.ext(all[i]) == ".txt") { txt += 1 }
        if (path.ext(all[i]) == ".md")  { md += 1 }
        i += 1
    }
    prln("文件总数 =", len(all), "| .txt =", txt, "| .md =", md)

    // 清理
    io.remove(path.join(root, "sub", "deep", "c.md"))
    io.remove(path.join(root, "sub", "deep"))
    io.remove(path.join(root, "sub", "b.txt"))
    io.remove(path.join(root, "sub"))
    io.remove(path.join(root, "a.txt"))
    io.remove(root)
    prln("清理完成，目录已消失 =", io.isDir(root) == false)
}

// 递归打印相对路径（先排序，保证输出稳定）
func walk(root, dir, depth) {
    local names = sortStrings(io.listDir(dir))
    local i = 1
    while (i <= len(names)) {
        local full = path.join(dir, names[i])
        prln(pad(depth) + names[i] + (io.isDir(full) ? "/" : ""))
        if (io.isDir(full)) { walk(root, full, depth + 1) }
        i += 1
    }
}


func pad(n) {
    local s = ""
    local i = 0
    while (i < n) {
        s += "  "
        i += 1
    }
    return s
}

// 收集所有文件（不含目录）的相对路径
//   （不能叫 collect —— 那是 GC 的内建函数名）
func collectFiles(root, dir, acc) {
    local names = sortStrings(io.listDir(dir))
    local i = 1
    while (i <= len(names)) {
        local full = path.join(dir, names[i])
        if (io.isDir(full)) { collectFiles(root, full, acc) }
        else { append(acc, path.normalize(full)) }
        i += 1
    }
    return acc
}

func sortStrings(t) {
    local n = len(t)
    local i = 2
    while (i <= n) {
        local key = t[i]
        local j = i - 1
        while (j >= 1 and t[j] > key) {
            t[j + 1] = t[j]
            j -= 1
        }
        t[j + 1] = key
        i += 1
    }
    return t
}
