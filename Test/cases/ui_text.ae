// =============================================================================
//  ui 文字验收：内容/字体/字号/粗斜/颜色/对齐/多行/层级/度量
// -----------------------------------------------------------------------------
//  判定方式：ui.pixel 离屏取色。
//  像素级断言用【全块字符 "█"】：它的墨迹几乎是满框的，所以只要按 textSize()
//  算出的【框中心】去采样就一定命中墨迹 —— 不能按字号硬编码偏移，因为文字框
//  比字号高（含 ascent/descent），墨迹通常从框顶往下几像素才开始。
// =============================================================================
imp ui

// 在 (x,y) 起的 n×n 区域里数等于 want 的像素
func patch(win, x, y, n, want) {
    local c = 0
    local j = 0
    while (j < n) {
        local i = 0
        while (i < n) {
            if (ui.pixel(win, x + i, y + j) == want) { c += 1 }
            i += 1
        }
        j += 1
    }
    return c
}

// 以 (cx,cy) 为中心取 6×6，看是不是墨迹（阈值放宽，避免卡在字形边缘）
func ink(win, cx, cy, want) { return patch(win, cx - 3, cy - 3, 6, want) >= 25 }

// 扫整个文字框（每 2 像素一格）数墨迹：中文的框中心正好落在两个字之间的空隙，
// 只采中心会误判成"没画出来"，所以这里扫一片
func inkInBox(win, x, y, w, h, want) {
    local n = 0
    local j = 0
    while (j < h) {
        local i = 0
        while (i < w) {
            if (ui.pixel(win, x + i, y + j) == want) { n += 1 }
            i += 2
        }
        j += 2
    }
    return n
}

func main() {
    local w = ui.window("文字验收", 240, 160)
    local bg = ui.pixel(w, 239, 159)

    // ── 1) 建文字对象 + 默认值 ──
    local t = ui.text(w, 10, 10, "Hello 世界")
    prln("kind =", ui.get(t, "kind"), "| text =", ui.get(t, "text"), "| size =", ui.get(t, "size"))
    prln("默认 font =", ui.get(t, "font"), "| 实际用上 =", ui.props(t).fontUsed)
    prln("默认 color =", ui.get(t, "color"), "| align =", ui.get(t, "align"),
         "| valign =", ui.get(t, "valign"), "| bold =", ui.get(t, "bold"))

    local s1 = ui.textSize(t)
    prln("textSize 为正 =", s1.w > 0 and s1.h > 0, "| 值 =", s1.w, s1.h)
    prln("props 的 tw/th 与 textSize 一致 =", ui.props(t).tw == s1.w and ui.props(t).th == s1.h)

    // ── 2) 字号影响度量 ──
    ui.set(t, "size", 32)
    local s2 = ui.textSize(t)
    prln("字号 16→32 后更宽 =", s2.w > s1.w, "| 更高 =", s2.h > s1.h, "|", s2.w, s2.h)
    ui.set(t, "size", 16)

    // ── 3) 普通文字确实有墨迹（扫它的框，数非背景像素）──
    local n1 = 0
    local y = 10
    while (y < 10 + s1.h) {
        local x = 10
        while (x < 10 + s1.w) {
            if (ui.pixel(w, x, y) != bg) { n1 += 1 }
            x += 1
        }
        y += 1
    }
    prln("普通文字框内有墨迹 =", n1 > 0, "| 墨迹像素 =", n1)
    ui.remove(t)

    // ── 4) 全块字符：位置 / 颜色 / 字号（都按框中心采样）──
    local RED = 0xFF0000
    local b = ui.text(w, 120, 70, "█")
    ui.setAll(b, {size = 32, color = "#FF0000"})
    local bs = ui.textSize(b)
    prln("块字符框 =", bs.w, "x", bs.h)
    prln("左上对齐时框中心有墨 =", ink(w, 120 + bs.w / 2, 70 + bs.h / 2, RED),
         "| 框外没墨 =", patch(w, 120 + bs.w + 4, 70 + bs.h / 2, 4, RED) == 0)

    ui.set(b, "color", "#00FF00")
    prln("改绿色后框中心变绿 =", ink(w, 120 + bs.w / 2, 70 + bs.h / 2, 0x00FF00),
         "| 红色没了 =", patch(w, 120, 70, bs.w, RED) == 0)

    ui.set(b, "size", 48)
    local bs2 = ui.textSize(b)
    prln("字号 32→48 更高 =", bs2.h > bs.h, "|", bs.h, "→", bs2.h,
         "| 原框中心仍有墨 =", ink(w, 120 + bs.w / 2, 70 + bs.h / 2, 0x00FF00))
    ui.set(b, "size", 32)

    // ── 5) 对齐：x/y 是锚点，align/valign 决定它落在框的哪条边 ──
    local cxL = 120 + bs.w / 2
    local cyT = 70 + bs.h / 2
    prln("左对齐：框心(120+w/2)有墨 =", ink(w, cxL, cyT, 0x00FF00),
         "| 靠右端(120+w-3)也有墨 =", ink(w, 120 + bs.w - 3, cyT, 0x00FF00))

    ui.set(b, "align", "center")                     // x 变成框的水平中心 → 整体左移半个框宽
    prln("改居中：新框心(x=120)有墨 =", ink(w, 120, cyT, 0x00FF00),
         "| 靠右端已空 =", not ink(w, 120 + bs.w - 3, cyT, 0x00FF00))
    ui.set(b, "align", "right")                      // x 变成框的右边
    prln("改右对齐：框心(120-w/2)有墨 =", ink(w, 120 - bs.w / 2, cyT, 0x00FF00))
    ui.set(b, "align", "left")
    prln("恢复左对齐：框心(120+w/2)又有墨 =", ink(w, cxL, cyT, 0x00FF00))

    ui.set(b, "valign", "middle")                    // y 变成框的垂直中心
    prln("改垂直居中：框心(y=70)有墨 =", ink(w, cxL, 70, 0x00FF00),
         "| 靠下端(70+h-3)已空 =", not ink(w, cxL, 70 + bs.h - 3, 0x00FF00))
    ui.set(b, "valign", "bottom")                    // y 变成框的下边
    prln("改底对齐：框心(70-h/2)有墨 =", ink(w, cxL, 70 - bs.h / 2, 0x00FF00))
    ui.set(b, "valign", "top")
    prln("恢复上对齐：框心又有墨 =", ink(w, cxL, cyT, 0x00FF00))
    ui.remove(b)

    // ── 6) 多行（\n）──
    local ml = ui.text(w, 20, 10, "█\n█")
    ui.setAll(ml, {size = 32, color = "#FF0000"})
    local ms = ui.textSize(ml)
    local one = ui.textSize(ml, "█").h
    prln("两行的框 ≈ 一行两倍高 =", float(ms.h) > float(one) * 1.8 and float(ms.h) < float(one) * 2.2, "|", one, "→", ms.h)
    prln("第一行有墨 =", ink(w, 20 + ms.w / 2, 10 + one / 2, RED),
         "| 第二行也有墨 =", ink(w, 20 + ms.w / 2, 10 + one + one / 2, RED))
    ui.remove(ml)

    // ── 7) 粗体/斜体确实改变渲染 ──
    local it = ui.text(w, 10, 100, "HHH")
    ui.setAll(it, {size = 30, color = "#000000"})
    local wReg = ui.textSize(it).w
    local inkPlain = patch(w, 10, 100, 20, 0x000000)
    ui.set(it, "bold", true)
    local inkBold = patch(w, 10, 100, 20, 0x000000)
    prln("bold =", ui.get(it, "bold"), "| 粗体墨更多 =", inkBold > inkPlain, "|", inkPlain, "→", inkBold)
    ui.set(it, "italic", true)
    prln("italic =", ui.get(it, "italic"), "| 斜粗体仍有墨 =", patch(w, 10, 100, 20, 0x000000) > 0)
    prln("bold+italic 后更宽或相等 =", ui.textSize(it).w >= wReg, "|", wReg, "→", ui.textSize(it).w)

    // ── 8) 字体族：存在的用，不存在的兜底（能查出来用了什么）──
    ui.set(it, "font", "Consolas")
    prln("设为 Consolas → fontUsed =", ui.props(it).fontUsed)
    ui.set(it, "font", "这个字体肯定不存在")
    prln("不存在的字体 → fontUsed =", ui.props(it).fontUsed,
         "| 仍然画得出来 =", patch(w, 10, 100, 20, 0x000000) > 0)
    ui.remove(it)

    // ── 9) 层级：文字和图形按 z 混排 ──
    local box = ui.rect(w, 0, 0, 80, 60)
    ui.setAll(box, {fill = true, fillColor = "#0000FF", stroke = 0, z = 0})
    local over = ui.text(w, 4, 4, "█")
    ui.setAll(over, {size = 32, color = "#FFFF00", z = 1})
    local os_ = ui.textSize(over)
    local ocx = 4 + os_.w / 2
    local ocy = 4 + os_.h / 2
    prln("文字在方块上面 =", ink(w, ocx, ocy, 0xFFFF00))
    ui.set(over, "z", -1)
    prln("文字 z 改到方块下面 =", patch(w, ocx - 3, ocy - 3, 6, 0xFFFF00) == 0,
         "| 露出方块 =", ink(w, ocx, ocy, 0x0000FF))
    ui.set(over, "visible", false)
    prln("隐藏文字后只剩方块 =", ink(w, ocx, ocy, 0x0000FF))
    ui.remove(over)
    ui.remove(box)

    // ── 10) textSize 临时量另一段内容 ──
    local q = ui.text(w, 5, 5, "█")
    ui.set(q, "size", 20)
    local w1 = ui.textSize(q).w
    local w4 = ui.textSize(q, "████").w
    prln("量另一段内容更宽 =", w4 > w1, "|", w1, "→", w4)

    // ── 11) 纯中文 / 全角标点 / 中英混排（★ 回归）──
    //  曾经的问题：排版框用的是"刚好量出来的尺寸"，而纯中文的实际排版宽度会比
    //  MeasureString 结果大一丁点（亚像素差），GDI+ 遇到"排不下"会【整段一个字都不画】。
    //  表现是：拉丁字母/数字正常，中文全空 —— 只测英文的用例根本发现不了。
    local CJK = 0xFF00FF
    local cj = ui.text(w, 10, 128, "居中文字")
    ui.setAll(cj, {size = 20, color = "#FF00FF"})
    local cjs = ui.textSize(cj)
    local nCjk = inkInBox(w, 10, 128, cjs.w, cjs.h, CJK)
    prln("纯中文画出来了 =", nCjk > 0, "| 墨迹 =", nCjk, "| 框", cjs.w, cjs.h)

    ui.set(cj, "text", "A中B文")
    local cjs2 = ui.textSize(cj)
    prln("中英混排画出来了 =", inkInBox(w, 10, 128, cjs2.w, cjs2.h, CJK) > 0,
         "| 框", cjs2.w, cjs2.h)

    ui.set(cj, "text", "，。！")
    local cjs3 = ui.textSize(cj)
    prln("全角标点画出来了 =", inkInBox(w, 10, 128, cjs3.w, cjs3.h, CJK) > 0,
         "| 框", cjs3.w, cjs3.h)

    ui.set(cj, "text", "World")
    local cjs4 = ui.textSize(cj)
    prln("英文画出来了（对照）=", inkInBox(w, 10, 128, cjs4.w, cjs4.h, CJK) > 0)
    ui.remove(cj)

    // ── 12) 错误路径 ──
    local r2 = ui.rect(w, 0, 0, 10, 10)
    local t2 = ui.text(w, 0, 0, "x")
    try { ui.set(r2, "color", "#FF0000") } catch (e) { prln("[-] " + e.msg) }
    try { ui.set(t2, "fill", true) } catch (e) { prln("[-] " + e.msg) }
    try { ui.set(t2, "stroke", 3) } catch (e) { prln("[-] " + e.msg) }
    try { ui.set(t2, "align", "middle") } catch (e) { prln("[-] " + e.msg) }
    try { ui.set(t2, "size", "大") } catch (e) { prln("[-] " + e.msg) }
    try { ui.set(t2, "text", 123) } catch (e) { prln("[-] " + e.msg) }
    try { ui.textSize(r2) } catch (e) { prln("[-] " + e.msg) }
    try { ui.setAll(t2, {fill = true}) } catch (e) { prln("[-] " + e.msg) }
    try { ui.setAll(r2, {size = 12}) } catch (e) { prln("[-] " + e.msg) }
    prln("shapes 里现在是", len(ui.shapes(w)), "个对象")
    prln("count =", ui.count(), "| lastError =", ui.lastError())
    ui.close(w)
}
