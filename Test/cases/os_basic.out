── 命令行 ──
argCount = 0 | len(args) = 0 | 内容 = {}
scriptPath 非空 = true
── 环境变量 ──
PATH 存在 = true | 长度 > 0 = true
不存在的变量 = null
lastError 非空 = true
setEnv = true | 回读 = hello
env() 条目 > 0 = true
── 目录 ──
cwd 非空 = true
tempDir 非空 = true
homeDir 存在 = true
chdir 到 tempDir = true
已切换 = true
chdir 回原目录 = true | 已还原 = true
chdir 到不存在 = false | lastError 非空 = true
── 时间 ──
time() 合理 = true
formatTime 长度 = 19 | 年份 = 2023
sleep(30) 实际 >= 25ms = true
millis 单调 = true
── 随机 ──
同种子可复现 = true | 在 0..999 = true
random() 非负 = true
randomFloat 在 [0,1) = true
── 系统信息 ──
platform 合法 = true
pid > 0 = true | hostname 非空 = true
cpuCount > 0 = true
