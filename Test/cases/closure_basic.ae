// =============================================================================
//  闭包验收：引用捕获 / 共享变量 / 传参返回 / 工厂 / 循环绑定 / 递归 /
//            多层嵌套 / 逃逸 / 表字段调用 / try-catch / 多返回值 / 错误路径
// -----------------------------------------------------------------------------
//  语义要点（都是刻意选定的）：
//    · 引用捕获：闭包和外部【共享同一个变量】，两边改都生效
//    · 每轮全新绑定：循环里建的闭包各自拿到【那一轮】的值（Lua / JS let 语义）
//    · 逃逸安全：闭包活过创建它的函数，值跟着走（帧退出时上值被"关闭"搬进堆）
//    · 匿名函数：func(x){...}；名字可选 func name(x){...}，用于递归
//    · 函数体内的 func name(){...} = 局部闭包（能捕获外层变量）
// =============================================================================
imp os

func main() {
    // ── 1) 引用捕获 + 外部可见 ──
    local n = 0
    local inc = func() { n += 1  return n }
    prln("1) 引用捕获:", inc(), inc(), inc(), "| 外面看 n =", n)
    local get = func() { return n }
    prln("2) 两个闭包共享同一变量:", get())

    // ── 2) 传参 / 返回 ──
    local apply = func(f, x) { return f(x) }
    prln("3) 闭包当参数:", apply(func(a) { return a * 2 }, 21))
    local mk = func(k) { return func() { return k * 10 } }
    local f3 = mk(3)
    local f7 = mk(7)
    prln("4) 工厂:", f3(), f7())

    // ── 3) 循环：每轮全新绑定 ──
    local h = {}
    local i = 0
    while (i < 3) {
        local j = i
        h[i + 1] = func() { return j * 100 }
        i += 1
    }
    prln("5) while 体局部变量:", h[1](), h[2](), h[3]())

    local btns = {}
    for k = 1, 3 { btns[k] = func() { return k } }
    prln("6) 数值 for 循环变量:", btns[1](), btns[2](), btns[3]())

    local t = {10, 20, 30}
    local gv = {}
    for idx, v in t { gv[v] = func() { return idx * 100 + v } }
    prln("7) 通用 for 两个变量:", gv[10](), gv[20](), gv[30]())

    local acc = {}
    local q = 0
    while (q < 4) {
        local sq = q * q
        if (q == 1) { q += 1  continue }
        if (q == 3) { break }
        acc[q + 1] = func() { return sq }
        q += 1
    }
    prln("8) continue/break 后仍然正确:", acc[1](), acc[3]())

    // ── 4) 递归（命名闭包）──
    local fact = func fact(x) { if (x <= 1) { return 1 }  return x * fact(x - 1) }
    prln("9) 命名闭包递归 5! =", fact(5))

    // ── 5) 多层嵌套：中间层要做上值中转 ──
    local a = 1
    local l1 = func() {
        local b = 2
        return func() {
            local c = 3
            return func() { return a + b + c }
        }
    }
    prln("10) 三层嵌套 =", l1()()())

    // ── 6) 逃逸：闭包活过创建它的函数（帧已退出）──
    local mkC = func(start) {
        local c = start
        return func() { c += 1  return c }
    }
    local c1 = mkC(10)
    local c2 = mkC(100)
    prln("11) 逃逸后各自独立:", c1(), c1(), c2(), c1())

    // ── 7) 函数值本身 ──
    prln("12) type =", type(f3), "| str =", str(f3), "| 同一性:", f3 == f3, f3 == f7)
    local box = {run = f3}
    prln("13) 表字段调用:", box.run())
    prln("14) 括号调用:", (f3)())

    // ── 8) 函数体内的 func 声明 = 局部闭包 ──
    local side = 0
    func bump() { side += 5 }
    bump() bump()
    prln("15) 嵌套声明捕获:", side)

    // ── 9) 闭包内 try/catch ──
    local boom = func() { try { error("炸") } catch (e) { return "caught:" + e.msg } }
    prln("16) 闭包内 try/catch:", boom())

    // ── 10) 多返回值穿越闭包 ──
    local two = func() { return 7, 8 }
    local p, r = two()
    prln("17) 多返回值:", p, r)

    // ── 11) 错误路径 ──
    local bad = 5
    try { bad() } catch (e) { prln("18) 调用非函数 ->", e.msg) }
    local nilf = null
    try { nilf() } catch (e) { prln("19) 调用 null ->", e.msg) }

    prln("20) os 仍然可用:", os.platform() != null)

    // ── 12) 循环里建的闭包改【外层】变量：必须共享同一个变量（★ 回归）──
    //   曾经的 bug：循环末尾"关闭上值"的槽位范围写成了从 0 开始，把外层函数的变量
    //   也一起关了 → 闭包只在改自己被摘下来的副本，外面永远不变。表现就是
    //   "循环里注册的按钮回调点了以后计数器不增加"。
    local total = 0
    local fs = {}
    local q2 = 0
    while (q2 < 3) {
        local tag = q2 + 1
        fs[q2 + 1] = func() { total += tag }
        q2 += 1
    }
    local r1 = fs[1]()
    local r2 = fs[2]()
    local r3 = fs[3]()
    prln("21) 循环闭包改外层变量:", total, "（应为 6：外层共享 + 每个闭包自己的 tag）")

    local sum2 = 0
    local fs2 = {}
    for k2 = 1, 3 { fs2[k2] = func() { sum2 += k2 } }
    local s1 = fs2[1]()
    local s2 = fs2[2]()
    local s3 = fs2[3]()
    prln("22) 数值 for 同样:", sum2, "（应为 6）")

    local d3 = 0
    local fs3 = {}
    local q3 = 0
    do {
        local t3 = q3 + 1
        fs3[q3 + 1] = func() { d3 += t3 }
        q3 += 1
    } while (q3 < 3)
    local d1 = fs3[1]()
    local d2 = fs3[2]()
    local d3r = fs3[3]()
    prln("23) do-while 同样:", d3, "（应为 6）")
}
