// =============================================================================
//  ui 事件演示 —— 想亲手玩就跑这个（不会被 run.ps1 当成用例）
//
//  跑法（在 Test 目录下）：
//      ..\Apt\aec.exe ui_event_demo.ae
//      ..\Apt\ae.exe ui_event_demo.aeo
//
//  可以试：
//    · 鼠标移到三个按钮上 → 变亮（mouseenter / mouseleave）
//    · 点按钮 → 计数增加、上方大字更新（click + 回调里改属性）
//    · 按住方块拖动 → 方块跟着走（mousedown / mousemove / mouseup）
//    · 方向键 → 移动方块；Esc → 退出（keydown）
//    · 拖窗口边改大小 → 标题显示尺寸（resize）
//    · 点右上角 X → 走 close 回调（这里故意"问一次"再关）
// =============================================================================
imp ui
imp os

func main() {
    local w = ui.window("ui 事件演示", 480, 340)
    if (w == null) { prln("[-] 建窗口失败:", ui.lastError()) return }
    ui.show(w)

    local bg = ui.rect(w, 0, 0, 480, 340)
    ui.setAll(bg, {fill = true, fillColor = "#0F1419", stroke = 0, z = -100})

    local title = ui.text(w, 240, 18, "点按钮 / 拖方块 / 按方向键 / Esc 退出")
    ui.setAll(title, {size = 17, color = "#94A3B8", align = "center", valign = "middle", z = 5})

    local big = ui.text(w, 240, 58, "点击次数: 0")
    ui.setAll(big, {size = 26, color = "#E2E8F0", align = "center", valign = "middle", bold = true, z = 5})

    // ── 三个按钮：悬停变亮、点击计数 ──
    local clicks = 0
    local buttons = {}
    local labels  = {}
    local names = {"红色按钮", "绿色按钮", "蓝色按钮"}
    local base = {"#7F1D1D", "#14532D", "#1E3A8A"}
    local hot  = {"#EF4444", "#22C55E", "#3B82F6"}
    local i = 0
    while (i < 3) {
        local b = ui.roundRect(w, 30 + i * 145, 100, 125, 44, 10)
        ui.setAll(b, {fill = true, fillColor = base[i + 1], stroke = 2, strokeColor = "#334155", z = 1})
        local t = ui.text(w, 30 + i * 145 + 62, 122, names[i + 1])
        ui.setAll(t, {size = 16, color = "#E2E8F0", align = "center", valign = "middle", z = 2})
        buttons[i + 1] = b
        labels[i + 1]  = t

        local idx = i + 1
        local cap = names[idx]
        ui.on(b, "mouseenter", func(e) { ui.set(buttons[idx], "fillColor", hot[idx]) })
        ui.on(b, "mouseleave", func(e) { ui.set(buttons[idx], "fillColor", base[idx]) })
        ui.on(b, "click", func(e) {
            clicks += 1
            ui.set(big, "text", "点击次数: " + str(clicks) + "（最近点的是" + cap + "）")
            ui.set(labels[idx], "text", names[idx] + " ✔")
        })
        i += 1
    }

    // ── 可拖动的方块（mousedown → mousemove → mouseup）──
    local box = ui.rect(w, 200, 200, 60, 60)
    ui.setAll(box, {fill = true, fillColor = "#F59E0B", stroke = 0, z = 3})
    local drag = false
    local dx = 0
    local dy = 0
    ui.on(box, "mousedown", func(e) { drag = true  dx = e.x - ui.get(box, "x")  dy = e.y - ui.get(box, "y") })
    ui.on(w,   "mouseup",   func(e) { drag = false })
    ui.on(w,   "mousemove", func(e) { if (drag) { ui.set(box, "x", e.x - dx)  ui.set(box, "y", e.y - dy) } })

    // ── 键盘：方向键移动、Esc 退出 ──
    ui.on(w, "keydown", func(e) {
        if (e.key == 27) { ui.close(w)  return true }          // Esc：从回调里直接关窗
        if (e.key == 37) { ui.set(box, "x", ui.get(box, "x") - 6) }
        if (e.key == 39) { ui.set(box, "x", ui.get(box, "x") + 6) }
        if (e.key == 38) { ui.set(box, "y", ui.get(box, "y") - 6) }
        if (e.key == 40) { ui.set(box, "y", ui.get(box, "y") + 6) }
        return false
    })

    // ── 改窗口大小：标题显示尺寸 ──
    local resized = 0
    ui.on(w, "resize", func(e) {
        resized += 1
        if (resized > 1) { ui.set(w, "title", "ui 事件演示 —— " + str(e.w) + " x " + str(e.h)) }
    })

    // ── close：故意"问一次"（第一次返回 true 取消关闭，第二次才放行）──
    local asked = 0
    ui.on(w, "close", func(e) {
        asked += 1
        if (asked == 1) {
            ui.set(big, "text", "再点一次 X 才真的关（这是 close 回调拦下来的）")
            return true                                        // true = 吃掉 → 不关
        }
        return false
    })

    prln("[+] 窗口已开：点按钮 / 拖方块 / 按方向键 / Esc 退出")
    ui.run(0)
    prln("[+] 退出）点击", clicks, "次 | drag 过 / resize", resized, "次 / close 询问", asked, "次")
}
