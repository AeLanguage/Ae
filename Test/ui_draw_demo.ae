// =============================================================================
//  ui 绘制演示 —— 想亲眼看就跑这个（不会被 run.ps1 当成用例）
//
//  跑法（在 Test 目录下）：
//      ..\Apt\aec.exe ui_draw_demo.ae
//      ..\Apt\ae.exe ui_draw_demo.aeo
//
//  点右上角 X 关闭 → 脚本退出。里面每一帧都在改属性（位置/半径/颜色/层级/圆角）。
// =============================================================================
imp ui
imp os

func main() {
    local w = ui.window("Ae 绘制演示", 620, 440)
    if (w == null) { prln("[-] 建窗口失败:", ui.lastError()) return }
    ui.show(w)

    // 背景板（z 很小，永远在最下面）
    local bg = ui.rect(w, 0, 0, 620, 440)
    ui.setAll(bg, {fill = true, fillColor = "#0F1419", stroke = 0, z = -100})

    // 文字：标题 / 卡片中心 / 四角矩形的中心 / 帧计数（都随帧改内容或位置）
    local title = ui.text(w, 30, 6, "Ae 绘制 + 文字演示")
    ui.setAll(title, {size = 20, color = "#E2E8F0", z = 5})
    local mid = ui.text(w, 155, 105, "居中文字")
    ui.setAll(mid, {size = 22, color = "#F8FAFC", align = "center", valign = "middle", bold = true, z = 5})
    local mid2 = ui.text(w, 465, 105, "四角独立圆角")
    ui.setAll(mid2, {size = 18, color = "#DBEAFE", align = "center", valign = "middle", z = 5})
    local counter = ui.text(w, 10, 414, "帧: 0")
    ui.setAll(counter, {size = 16, color = "#94A3B8", z = 5})

    // 圆角卡片
    local card = ui.roundRect(w, 30, 30, 250, 150, 18)
    ui.setAll(card, {fill = true, fillColor = "#1E293B", stroke = 2, strokeColor = "#334155", z = 0})

    // 四角独立圆角
    local corners = ui.rect(w, 340, 30, 250, 150)
    ui.setAll(corners, {fill = true, fillColor = "#2563EB", stroke = 0,
                        rtl = 50, rtr = 0, rbr = 50, rbl = 0, z = 0})

    // 实心圆 + 空心圆环（圆环每帧改半径/线宽）
    local dot  = ui.circle(w, 130, 300, 34)
    ui.setAll(dot, {fill = true, fillColor = "#F59E0B", stroke = 0, z = 1})
    local ring = ui.circle(w, 130, 300, 55)
    ui.setAll(ring, {fill = false, stroke = 6, strokeColor = "#FDE68A", aa = true, z = 2})

    // 多边形（面）：每帧左右移动
    local poly = ui.poly(w, {0, 0, 80, 40, 50, 110, 5, 80})
    ui.setAll(poly, {x = 300, y = 250, fill = true, fillColor = "#22C55E",
                     stroke = 3, strokeColor = "#86EFAC", z = 1})

    // 粗线：每帧换颜色，并演示层级（让它在多边形上下切换）
    local ln = ui.line(w, 380, 250, 580, 400)
    ui.setAll(ln, {stroke = 10, strokeColor = "#EF4444", z = 3})

    // 一片点：每帧换颜色
    local dots = {}
    local i = 0
    while (i < 9) {
        local p = ui.point(w, 400 + (i % 3) * 70, 60 + (i / 3) * 45)
        ui.setAll(p, {r = 9, fillColor = "#38BDF8", z = 1})
        dots[i + 1] = p
        i += 1
    }

    local colors = {"#EF4444", "#F59E0B", "#22C55E", "#38BDF8", "#A855F7"}
    local t = 0
    while (ui.count() > 0) {
        t += 1

        // 三角波当"来回"（还没有数学库，凑合）
        local ph = t % 160
        if (ph > 80) { ph = 160 - ph }
        ui.set(dot, "x", 90 + ph * 2)
        ui.set(ring, "x", 90 + ph * 2)

        // 圆环呼吸
        local r = 40 + (t % 40)
        ui.set(ring, "r", r)
        ui.set(ring, "stroke", 3 + (t % 6))

        // 多边形左右移动 + 线宽呼吸
        ui.set(poly, "x", 280 + ph)
        ui.set(ln, "stroke", 4 + (t % 12))
        ui.set(ln, "strokeColor", colors[(t / 30) % 5 + 1])

        // 层级切换：每 3 秒把线放到多边形下面一次
        if (t % 180 == 0) { ui.set(ln, "z", 0) }
        if (t % 180 == 90) { ui.set(ln, "z", 3) }

        // 点整片换色
        if (t % 60 == 0) {
            local c = colors[(t / 60) % 5 + 1]
            local k = 1
            while (k <= len(dots)) { ui.set(dots[k], "fillColor", c)  k += 1 }
        }

        ui.set(counter, "text", "帧: " + str(t) + "  （圆环半径 " + str(r) + "）")
        ui.set(mid, "color", colors[(t / 30) % 5 + 1])
        ui.set(w, "title", "Ae 绘制演示 —— 第 " + str(t) + " 帧（点 X 退出）")
        ui.pump()
        os.sleep(16)
    }
}
