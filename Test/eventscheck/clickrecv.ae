// 真实消息验收用：开个窗口等人 PostMessage 真消息过来（由 Test/check_events.ps1 驱动）
imp ui
imp os

func main() {
    local w = ui.window("CLICKRECV", 240, 160)
    ui.show(w)
    local hits = 0
    local last = ""
    local btn = ui.rect(w, 20, 20, 200, 60)
    ui.setAll(btn, {fill = true, fillColor = "#224466", stroke = 0, z = 1})
    local lab = ui.text(w, 120, 50, "真消息测试")
    ui.setAll(lab, {size = 18, color = "#FFFFFF", align = "center", valign = "middle", z = 2})
    ui.on(btn, "click", func(e) {
        hits += 1
        last = "click x=" + str(e.x) + " y=" + str(e.y) + " target是按钮=" + str(e.target == btn)
        prln("[事件] " + last)
    })
    ui.on(btn, "mouseenter", func(e) { prln("[事件] mouseenter") })
    ui.on(w, "keydown", func(e) { prln("[事件] keydown key=" + str(e.key)) })
    ui.on(w, "close", func(e) {
        prln("[汇总] 共收到 click " + str(hits) + " 次")
        return false                       // 放行 → 窗口真的关掉
    })
    prln("[就绪] 等待真实消息")
    ui.run(0)
    prln("[退出] 最后一条: " + last)
}
