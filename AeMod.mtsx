// =============================================================================
//  Ae Language Syntax Highlight  ——  MT Manager (.mtsx)
//  ---------------------------------------------------------------------------
//  版本     : v3.0.0  (对齐 aec.cpp + ae.cpp 完整语言规范)
//  适用     : MT 管理器 >= 2.19.0
//  安装     : MT 管理器打开本文件 → [安装] → 编辑 .ae 文件即可
//
//  ▌本文件严格对照以下源码:
//      aec.cpp (编译器词法/语法) + ae.cpp (VM 字节码运行时)
//
//  ▌Ae 语言完整词法 (来自 aec.cpp Lexer::next):
//
//    [关键字]  if else while break continue return func local
//    [布尔]    true false
//    [内置I/O] pr prln inp          (VM: BID_pr=0, BID_inp=1, BID_prln=2)
//    [内置转换] len str int float    (VM: BID_len=3, BID_str=4, BID_int=5, BID_float=6)
//    [入口]    main
//    [类型]    无显式类型声明 (运行时: int / double / string / bool)
//    [运算符]  = += -= *= /= == != < <= > >= + - * / %
//    [分隔符]  ( ) , { }
//    [注释]    // 单行
//    [字符串]  "..."  '...'   (支持 \n \t \\ \" \' 等转义)
//    [数字]    整数 / 浮点 (.5 / 5. / 1e3 风格, 十进制)
//
//  ▌高亮策略:
//    - 自定义函数定义/调用分离 (捕获组 + 靠前优先)
//    - 参数高亮 (func 括号内形参)
//    - local 局部变量声明高亮
//    - 内置函数分类着色 (I/O 类 vs 类型转换类)
//    - 莫奈粉 (Monet Pink) 配色, 低饱和久看不累
// =============================================================================

// require MT >= 2.19.0

{
name: ["AeMod", ".m"],
hide: false,
ignoreCase: false,

// ---- 样式定义 -------------------------------------------------------------
// 格式: "风格名", 日间前景, 夜间前景 [, 修饰]
// 修饰: @B 粗体  @I 斜体  @U 下划线  @S 删除线
// 背景色: 把 # 换成 $  (如 #AABBCC → $AABBCC)
// 继承:   "新名" > "旧名"  (继承旧名的所有颜色/修饰)
// ---------------------------------------------------------------------------
styles: [
  // ── 基础 ──
  "default",      #3D2B36, #EED2DC,                          // 默认文本 (深藕灰 / 浅粉白)
  "comment",      #A89898, #B0A0A0,                    @I,    // 注释 (柔灰斜体)
  "string",       #8B5B7A, #E6A8D7,                          // 字符串
  "strEscape",    #C06040, #FFA07A,                          // 字符串内转义 \n \t 等

  // ── 数值 & 布尔 ──
  "number",       #C96B3E, #FFB088,                          // 整数 / 浮点数
  "bool",         #B23B5E, #FF9BB5,                    @B,   // true / false

  // ── 关键字 ──
  "keyword",      #A33B5C, #F4A7B9,                    @B,   // 控制流 if/else/while/break/continue/return
  "funcDef",      #8C2F52, #F6C1D0,                    @B,   // func 关键字 (定义函数)
  "local",        #7B4B6B, #C9A0C9,                    @B,   // local 关键字 (局部变量声明)

  // ── 函数相关 (核心高亮) ──
  "funcName",     #C75B7A, #FFB6C1,                    @B,   // 函数【定义】名 (func 后那个)
  "funcCall",     #D66A92, #F7A8C4,                          // 函数【调用】 name(
  "param",        #A85C78, #E8B4CC,                    @I,   // 形参 (func 括号内)

  // ── 内置函数 (分类着色) ──
  "builtinIO",    #B04A70, #FF9BB5,                    @B,   // I/O 内置: pr / prln / inp
  "builtinConv",  #9050A0, #D4A0E8,                    @B,   // 转换内置: len / str / int / float

  // ── 标识符 ──
  "localVar",     #7C5B8A, #CBA6DB,                          // local 声明的变量名

  // ── 运算符 & 标点 ──
  "operator",     #6B4B7A, #C9A0DC,                          // 运算符 = + - * / % == != 等
],

// ---- 注释 (Ae 仅 // 单行) ------------------------------------------------
comment: { startsWith: "//" },

// ---- 括号配对 -------------------------------------------------------------
// ⚠️ 每项必须恰好【两个字符】且【两字符不能相同】
//    "()" 合法,  "(( " 非法,  """" 非法
// ⚠️ 不含字符串引号 (引号由字符串 start-end 匹配器独立处理)
bracketPairs: ["()", "[]", "{}"],

// ---- 命名匹配器 (defines) ------------------------------------------------
//  供 contains 中通过 {include: "xxx"} 复用
//  支持自递归 / 交叉递归引用 (但不能有循环硬性依赖)
//  可选 addToContains: false → 不自动混入顶层, 仅供显式 include
// ---------------------------------------------------------------------------
defines: [
  // 标识符 (Ae: 字母/_ 开头, 后跟字母数字下划线)
  "ident": /\b[A-Za-z_][A-Za-z0-9_]*\b/,

  // 函数调用: 标识符 紧跟 ( (允许中间有空格)
  //   → 用于区分 "调用" 与 "普通变量引用"
  "call": /\b[A-Za-z_][A-Za-z0-9_]*(?=\s*\()/,
],

// ---- 匹配规则 (contains) --------------------------------------------------
//  ★ 核心规则: 位置最靠前者胜; 同位置则列表中靠前者胜
//  ★ 编写原则: 更【长/具体】的规则放前面, 更【短/通用】的放后面
//  ★ 关键顺序: 字符串 → 数字 → 函数定义 → 函数调用 → 关键字 → 运算符
// ---------------------------------------------------------------------------
contains: [

  // ══════════════════════════════════════════════════════════════════════
  //  1. 字符串: 双引号 "..."  ────────────────────────────────────────────
  //  start/end 匹配器: 起点终点竞争匹配, 内部 contains 二次着色
  // ══════════════════════════════════════════════════════════════════════
  {
    style: "string",
    start: { match: /"/ },
    end:   { match: /"/ },
    contains: [
      // 转义序列: \n \t \r \\ \" \' \0 \x41 \u0041 等
      { match: /\\(?:[nrt'"\\0]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4})/, 0: "strEscape" },
      // 非法/未知转义也捕获 (如 \q) → 着转义色, 视觉上便于发现错误
      { match: /\\./, 0: "strEscape" },
    ],
  },

  // ══════════════════════════════════════════════════════════════════════
  //  2. 字符串: 单引号 '...'  ────────────────────────────────────────────
  //  Ae 同时支持 ' 和 " 作为字符串定界符 (aec.cpp: c == '"' || c == '\'')
  // ══════════════════════════════════════════════════════════════════════
  {
    style: "string",
    start: { match: /'/ },
    end:   { match: /'/ },
    contains: [
      { match: /\\(?:[nrt'"\\0]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4})/, 0: "strEscape" },
      { match: /\\./, 0: "strEscape" },
    ],
  },

  // ══════════════════════════════════════════════════════════════════════
  //  3. 数字 (官方 number 匹配器)  ───────────────────────────────────────
  //  "10|F" = 十进制(10) + 浮点(F)
  //    → 覆盖: 42  .5  5.  3.14  1e3  2.5e-10
  //  ⚠️ 无 iSuffixes/fSuffixes (Ae 无 0x/0b 前缀, 无 l/f 后缀)
  //  ⚠️ 不写 iSuffixes:"" (空串会触发 token recognition error)
  // ══════════════════════════════════════════════════════════════════════
  { number: "10|F", style: "number" },

  // ══════════════════════════════════════════════════════════════════════
  //  4. 函数【定义】头部 :  func Name(  ─────────────────────────────────
  //  ★ 捕获组:  1 = "func" (关键字色)   2 = 函数名 (定义名色)
  //  ★ 必须在「函数调用」规则之前 (靠前优先)
  //     → 保证 func foo( 里的 foo 被定义规则吃掉, 不再被调用规则覆盖
  //  ★ Ae 语法:  func name(param1, param2, ...) { ... }
  // ══════════════════════════════════════════════════════════════════════
  {
    match: /\b(func)\s+([A-Za-z_][A-Za-z0-9_]*)\s*\(/,
    1: "funcDef",
    2: "funcName",
  },

  // ══════════════════════════════════════════════════════════════════════
  //  5. 函数【调用】 :  Name(  ─────────────────────────────────────────
  //  标识符紧跟 ( → 视为函数调用
  //  定义处的 foo 已被规则4吃掉 → 这里只着色"调用处"
  //  包括: 自定义函数 + 内置函数调用 (pr(x) / len(s) 等)
  // ══════════════════════════════════════════════════════════════════════
  { match: include("call"), 0: "funcCall" },

  // ══════════════════════════════════════════════════════════════════════
  //  6. 控制流 & 结构关键字  ────────────────────────────────────────────
  //  if else while break continue return
  //  keywordsToRegex() 自动优化关键字正则表达式
  // ══════════════════════════════════════════════════════════════════════
  { match: keywordsToRegex(
      "if else while break continue return"
    ), 0: "keyword" },

  // ══════════════════════════════════════════════════════════════════════
  //  7. 布尔字面量  ─────────────────────────────────────────────────────
  //  true false
  // ══════════════════════════════════════════════════════════════════════
  { match: keywordsToRegex(
      "true false"
    ), 0: "bool" },

  // ══════════════════════════════════════════════════════════════════════
  //  8. 内置函数 — I/O 类 (VM BID: pr=0, inp=1, prln=2)  ───────────────
  //  pr prln inp
  //  单独着色, 区别于类型转换类, 便于快速识别副作用操作
  // ══════════════════════════════════════════════════════════════════════
  { match: keywordsToRegex(
      "pr prln inp"
    ), 0: "builtinIO" },

  // ══════════════════════════════════════════════════════════════════════
  //  9. 内置函数 — 类型转换/查询类 (VM BID: len=3, str=4, int=5, float=6) ─
  //  len str int float
  //  这些在词法器中作为 TK_IDENT, 运行时按名字识别 (aec.cpp builtinId)
  // ══════════════════════════════════════════════════════════════════════
  { match: keywordsToRegex(
      "len str int float"
    ), 0: "builtinConv" },

  // ══════════════════════════════════════════════════════════════════════
  //  10. main 入口  ─────────────────────────────────────────────────────
  //  Ae 程序入口:  main { ... }  (aec.cpp: cur.text == "main")
  //  着关键字色, 与普通函数调用区分
  // ══════════════════════════════════════════════════════════════════════
  { match: /\bmain\b/, 0: "keyword" },

  // ══════════════════════════════════════════════════════════════════════
  //  11. 局部变量声明 :  local name  ────────────────────────────────────
  //  ★ 捕获组:  1 = "local" (关键字色)   2 = 变量名 (局部变量色)
  //  Ae 语法:  local x = 42   (仅在函数体内有效)
  // ══════════════════════════════════════════════════════════════════════
  {
    match: /\b(local)\s+([A-Za-z_][A-Za-z0-9_]*)/,
    1: "local",
    2: "localVar",
  },

  // ══════════════════════════════════════════════════════════════════════
  //  12. 运算符 (复合赋值优先 → 靠前优先避免被拆散)  ────────────────────
  //  先匹配 2 字符: += -= *= /= == != <= >=
  //  再匹配 1 字符: = + - * / % < >
  // ══════════════════════════════════════════════════════════════════════
  { match: /[+\-*\/%<>!]=/, 0: "operator" },
  { match: /[=+\-*\/%<>!]/, 0: "operator" },

  // ══════════════════════════════════════════════════════════════════════
  //  13. 分隔 / 结构标点  ───────────────────────────────────────────────
  //  , ;
  // ══════════════════════════════════════════════════════════════════════
  { match: /[;,]/, 0: "operator" },
],
}
