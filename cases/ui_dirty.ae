// =============================================================================
//  第四批验收：脏矩形（局部重画）+ 每窗口一张离屏缓冲
// -----------------------------------------------------------------------------
//  判定方式有两种，都很硬：
//    ① ui.damage(表面) 的计数器 —— 证明"真的只重画了一小块"（drawn/skipped/full）
//    ② 逐像素比对 —— 改一堆东西之后，【脏画】的画面和【整面重画】的画面必须
//       一个像素都不差（这是正确性的底线：局部重画绝不能画错/留残影）
//
//  注意 ui.pixel 现在也是读缓冲：它会把待重画的那块先画完再读，所以
//  "改属性 → ui.pixel → ui.damage" 这种顺序里，重画是 pixel 触发的。
// =============================================================================
imp ui

func snap(w, cw, ch) {                      // 抓整个窗口的像素
    local s = {}
    local y = 0
    while (y < ch) {
        local x = 0
        while (x < cw) {
            s[y * cw + x + 1] = ui.pixel(w, x, y)
            x += 1
        }
        y += 1
    }
    return s
}
func diffPix(a, b) {                        // 两张快照不同的像素个数
    local n = 0
    local k = 1
    while (k <= len(a)) {
        if (a[k] != b[k]) { n += 1 }
        k += 1
    }
    return n
}

func main() {
    local CW = 160
    local CH = 120
    local w = ui.window("第四批验收", CW, CH)

    // ── 场景：底色 + 3 个方块 + 一列小点 ──
    local bg = ui.rect(w, 0, 0, CW, CH)
    ui.setAll(bg, {fill = true, fillColor = "#F1F5F9", stroke = 0, z = -10, aa = false})
    local b1 = ui.rect(w, 10, 10, 40, 30)
    ui.setAll(b1, {fill = true, fillColor = "#FF0000", stroke = 0})
    local b2 = ui.rect(w, 70, 10, 40, 30)
    ui.setAll(b2, {fill = true, fillColor = "#0000FF", stroke = 0})
    local dots = {}
    local i = 0
    while (i < 20) {
        local d = ui.circle(w, 8 + i * 7, 100, 3)
        ui.setAll(d, {fill = true, fillColor = "#64748B", stroke = 0})
        dots[i + 1] = d
        i += 1
    }

    // ── 1. 第一次一定是整面重画 ──
    ui.redraw(w)
    ui.pump()
    local d = ui.damage(w)
    prln("1) 首次: full =", d.full, "| 重画 =", d.drawn, "个 | 跳过 =", d.skipped, "| 块 =", d.rects)

    // ── 2. 只改一个小图形：待重画的就是那一小块 ──
    ui.set(b1, "fillColor", "#00FF00")
    d = ui.damage(w)
    prln("2) 改 1 个图形: 待重画 =", d.pending, "块", d.pw, "x", d.ph,
         "| 待整面 =", d.pendingFull, "| 还没画 =", d.paints == 1)
    local p0 = ui.damage(w).paints
    ui.pump()
    d = ui.damage(w)
    prln("3) 重画后: full =", d.full, "| 重画 =", d.drawn, "个 | 跳过 =", d.skipped,
         "个 | 重画次数只 +1 =", d.paints == p0 + 1)
    prln("4) 像素真的变了 =", ui.pixel(w, 30, 20) == 0x00FF00,
         "| 别处没动 =", ui.pixel(w, 90, 20) == 0x0000FF)

    // ── 3. 没改动就不重画 ──
    p0 = ui.damage(w).paints
    ui.pump()
    ui.pump()
    prln("5) 没有改动就不重画 =", ui.damage(w).paints == p0)

    // ── 4. 挪图形：旧位置要擦干净，新位置要画出来 ──
    ui.set(b2, "x", 20)
    ui.set(b2, "y", 60)
    ui.pump()
    d = ui.damage(w)
    prln("6) 挪一个图形: 重画 =", d.drawn, "个 | 旧位置空了 =", ui.pixel(w, 90, 20) != 0x0000FF,
         "| 新位置有 =", ui.pixel(w, 30, 70) == 0x0000FF, "| 重画区 =", d.w, "x", d.h)

    // ── 5. 被上层盖住时改下层：上层必须跟着重画（不然会破个洞）──
    local under = ui.rect(w, 100, 60, 50, 40)
    ui.setAll(under, {fill = true, fillColor = "#F59E0B", stroke = 0, z = 1})
    local over = ui.rect(w, 120, 70, 50, 40)
    ui.setAll(over, {fill = true, fillColor = "#8B5CF6", stroke = 0, z = 2})
    ui.pump()
    ui.set(under, "fillColor", "#10B981")
    ui.pump()
    d = ui.damage(w)
    prln("7) 改被盖住的下层: 重画 =", d.drawn, "个（上层也要画）",
         "| 重叠处还是上层 =", ui.pixel(w, 130, 80) == 0x8B5CF6,
         "| 露出来的地方变了 =", ui.pixel(w, 105, 65) == 0x10B981)

    // ── 6. 脏画 vs 整画：逐像素比对（正确性底线）──
    local bad = 0
    local names = {"改颜色", "挪图形", "转图形", "隐藏显示", "改组位置", "改 z",
                   "改裁剪", "加图形", "删图形", "缩放"}
    local g = ui.group(w)
    local gr = ui.rect(g, 5, 5, 30, 20)
    ui.setAll(gr, {fill = true, fillColor = "#E11D48", stroke = 0})
    ui.pump()
    ui.redraw(w)
    ui.pump()
    local ri = 1
    while (ri <= 10) {
        if (ri == 1)  { ui.set(gr, "fillColor", "#22D3EE") }
        if (ri == 2)  { ui.set(b1, "x", 50) }
        if (ri == 3)  { ui.set(b2, "angle", 30) }
        if (ri == 4)  { ui.set(dots[3], "visible", false) }
        if (ri == 5)  { ui.setAll(g, {x = 40, y = 30}) }
        if (ri == 6)  { ui.set(over, "z", -3) }
        if (ri == 7)  { ui.setAll(under, {clipX = 100, clipY = 60, clipW = 25, clipH = 40}) }
        if (ri == 8)  { ui.circle(w, 60, 60, 9) }
        if (ri == 9)  { ui.remove(dots[5]) }
        if (ri == 10) { ui.setAll(gr, {scale = 1.5, angle = 15}) }
        ui.pump()                                   // 只重画脏的那块
        local part = snap(w, CW, CH)
        ui.redraw(w)                                // 强制整面重画
        ui.pump()
        local fullp = snap(w, CW, CH)
        local n = diffPix(part, fullp)
        if (n != 0) { bad += 1 }
        prln("8.", ri, ") ", names[ri], ": 脏画 vs 整画 不同像素 =", n)
        ri += 1
    }
    prln("9) 十轮改动里画错的轮数 =", bad)

    // ── 7. 画布：内容变了只重画映射过去的那块 ──
    local cv = ui.canvas(80, 60)
    local cbg = ui.rect(cv, 0, 0, 80, 60)
    ui.setAll(cbg, {fill = true, fillColor = "#FFFFFF", stroke = 0, aa = false})
    local cdot = ui.circle(cv, 20, 20, 8)
    ui.setAll(cdot, {fill = true, fillColor = "#EF4444", stroke = 0})
    local cimg = ui.drawImage(w, cv, 60, 60, 40, 30)
    ui.setAll(cimg, {z = 9})
    ui.redraw(w)
    ui.pump()
    prln("10) 画布贴上去 =", ui.pixel(w, 70, 70) == 0xEF4444)
    local dp0 = ui.damage(cv).paints
    local dw0 = ui.damage(w).paints
    ui.set(cdot, "fillColor", "#2563EB")
    ui.pump()
    prln("11) 只动画布里的小圆: 画布重画", ui.damage(cv).drawn, "个（+1 次 =",
         ui.damage(cv).paints == dp0 + 1, "）| 窗口重画", ui.damage(w).drawn,
         "个 | 画布区 =", ui.damage(cv).w, "x", ui.damage(cv).h,
         "| 窗口区 =", ui.damage(w).w, "x", ui.damage(w).h)
    prln("12) 窗口上跟着变了 =", ui.pixel(w, 70, 70) == 0x2563EB,
         "| 画布自己也变了 =", ui.pixel(cv, 20, 20) == 0x2563EB)

    // ── 8. redraw 强制整面 ──
    ui.redraw(w)
    d = ui.damage(w)
    prln("13) ui.redraw 之后是整面待重画 =", d.pendingFull, "| 块 =", d.pending)

    prln("14) 收尾: 窗口数 =", ui.count(), "| lastError =", ui.lastError())
    ui.close(w)
}
