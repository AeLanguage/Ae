── 整文件读写 ──
writeFile -> true
readFile 长度 = 12 行数 = 3
appendFile -> true
追加后行数 = 4
── 元信息 ──
exists = true | isFile = true | isDir = false
size = 40 | isDir(目录) = true
exists(不存在) = false
── 目录 ──
listDir 条目数 = 2 | 排序后 = {a.txt, b.txt}
── 流式读取 ──
句柄 = true
readLine 1 = 第一行
readLine 2 = 第二行
tell = true
seek(0) = true | readLine 回到首行 = true
readAll 长度 > 0 = true
close = true
── 流式写入 ──
write 字节数 = 3 | flush = true | close = true
回读 = xyz
── 错误处理（不中断，用 lastError）──
读取不存在 = null | lastError 非空 = true
删除不存在 = false
── 复制 / 重命名 ──
copyFile = true | 副本存在 = true
rename = true | 新名存在 = true
── 清理 ──
remove 全部 = true true true true
remove 目录 = true | 目录已消失 = true
