// P0-6 验收：整数溢出 = 确定的二进制回绕（不再是有符号溢出 UB）
func main() {
    local mx = 9223372036854775807
    prln("1) INT64_MAX + 1 (期望 -9223372036854775808):", mx + 1)
    prln("2) INT64_MAX + 2 (期望 -9223372036854775807):", mx + 2)
    prln("3) INT64_MAX * 2 (期望 -2):", mx * 2)

    local mn = 0 - mx - 1
    prln("4) INT64_MIN      (期望 -9223372036854775808):", mn)
    prln("5) INT64_MIN - 1  (期望  9223372036854775807):", mn - 1)
    prln("6) INT64_MIN / -1 (期望 -9223372036854775808):", mn / -1)
    prln("7) INT64_MIN % -1 (期望 0):", mn % -1)
    prln("8) -INT64_MIN     (期望 -9223372036854775808):", -mn)

    prln("9) 常规算术未受影响:", 2 + 3 * 4, 10 / 3, 7 % 3, 10.0 / 4, 7.5 % 2.0)
}
