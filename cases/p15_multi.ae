// P1-4 / P1-5 / P1-7 验收
func divmod(a, b) {
    return a / b, a % b
}
func minmax(t) {
    local lo = t[1]
    local hi = t[1]
    local i = 2
    while (i <= len(t)) {
        if (t[i] < lo) { lo = t[i] }
        if (t[i] > hi) { hi = t[i] }
        i += 1
    }
    return lo, hi
}
func sideEffect(tag, v) {
    pr("<" + tag + ">")
    return v
}

func main() {
    prln("── P1-5 多返回值 ──")
    local q, r = divmod(17, 5)
    prln("17/5 商余:", q, r)

    local lo, hi = minmax({3, 9, 1, 7})
    prln("minmax:", lo, hi)

    local a = 1
    local b = 2
    a, b = b, a
    prln("交换后 a,b:", a, b)

    a, b = divmod(9, 2)
    prln("多赋值取多值:", a, b)

    local x = 0
    local y = 0
    x, y = 100, divmod(7, 2)
    prln("混合右侧:", x, y)

    local only = divmod(8, 3)
    prln("只要第一个:", only)

    prln("直接打印调用:", divmod(11, 4))

    prln("── P1-4 and/or/not ──")
    prln("0 or 5 =", 0 or 5, "| 1 or 5 =", 1 or 5)
    prln("null or 7 =", null or 7, "| '' or d =", "" or "d")
    prln("1 and 2 =", 1 and 2, "| 0 and 2 =", 0 and 2)
    prln("短路 A:", sideEffect("A", 1) or sideEffect("B", 2))
    prln("短路 B:", sideEffect("C", 0) and sideEffect("D", 2))
    prln("not:", not true, not false, not 0, not 1, not "", not null)
    prln("优先级 1 or 0 and 0 =", 1 or 0 and 0)

    prln("── P1-7 三元 ──")
    prln(true ? "yes" : "no", "|", false ? "yes" : "no")
    prln("惰性:", 1 ? "t" : sideEffect("X", 0))
    prln("嵌套:", 2 > 1 ? (3 > 2 ? "a" : "b") : "c")
    prln("组合:", (0 or 0) ? "T" : "F", not (1 and 0))
}
