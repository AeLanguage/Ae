// P0-1 验收：块作用域与遮蔽
func sumTo(n) {
    local sum = 0
    while (n > 0) {
        local term = n      // 循环体内局部，每轮独立
        sum += term
        n -= 1
    }
    return sum
}

func main() {
    local x = 1
    if (true) { local x = 99 }
    prln("1) if 块内 local x 不应改写外层 (期望 1):", x)

    local i = 0
    while (i < 3) {
        local d = i * 10
        prln("2) 循环体 local d (期望 0/10/20):", d)
        i += 1
    }
    prln("3) 循环后 i (期望 3):", i)

    local y = 5
    {
        local y = 50
        local z = y + 1
        prln("4) 内层遮蔽 y 与 z (期望 50 / 51):", y, z)
    }
    prln("5) 块外 y 应回到外层 (期望 5):", y)
    prln("6) 块内 z 已不可见 (期望 null):", z)

    if (true) { local q = 1  prln("7) 兄弟块 A q (期望 1):", q) }
    if (true) { local q = 2  prln("8) 兄弟块 B q (期望 2):", q) }

    prln("9) 形参遮蔽 (期望 99):", shadowParam(7))
    prln("10) 上层变量在块内可读 (期望 42):", readOuter(42))
    prln("11) 嵌套块 (期望 7):", nested())
    prln("12) 循环内局部累加 (期望 10):", sumTo(4))
}

func shadowParam(a) {
    local a = 99
    return a
}

func readOuter(v) {
    {
        local t = v * 1
        return t
    }
    return 0
}

func nested() {
    local a = 1
    {
        local b = a + 2
        {
            local c = b + 4
            return c
        }
    }
    return 0
}
