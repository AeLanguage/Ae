// json 库验收（★ 这个库本身是用 Ae 写的：Apt/lib/json.m）
imp json

func main() {
    prln("── 1) 解码：各种类型 ──")
    local v = json.decode("{\"name\":\"Ae\",\"version\":2,\"pi\":3.14,\"ok\":true,\"none\":null,\"tags\":[\"a\",\"b\",\"c\"],\"nested\":{\"deep\":[1,2,3]}}")
    prln("name =", v.name, "| version =", v.version, "| pi =", v.pi)
    prln("ok =", v.ok, "| none =", v.none, "| tags =", v.tags)
    prln("nested.deep[2] =", v.nested.deep[2])
    prln("类型检查:", type(v.version), type(v.pi), type(v.ok), type(v.tags))

    prln("── 2) 转义与 Unicode ──")
    local s = json.decode("\"tab:\\t 换行:\\n 引号:\\\" 反斜杠:\\\\ 中文:\\u4e2d\\u6587\"")
    prln("解码结果 =", s)
    prln("往返一致 =", json.decode(json.encode(s)) == s)

    prln("── 3) 编码：紧凑与美化 ──")
    local cfg = {name = "Ae", version = 2, tags = {"x", "y"}, nested = {on = true}}
    prln("紧凑 =", json.encode(cfg))
    prln("美化 =")
    prln(json.encodePretty(cfg))
    prln("缩进 4 =")
    prln(json.encodePrettyN(cfg, 4))

    prln("── 4) 数组与对象混用 + 数字格式 ──")
    prln(json.encode({1, 2, 3}))
    prln(json.encode({}))
    prln(json.encode({1.5, 0.1 + 0.2, 3000000000, -7}))
    prln("空表编码 =", json.encode({}))

    prln("── 5) 错误处理（用 try/catch 包 decode）──")
    local bad = {"{\"a\":}", "{\"a\" 1}", "[1,2", "tru", "\"没闭合", "[1,null,3]"}
    local i = 1
    while (i <= len(bad)) {
        try {
            local r = json.decode(bad[i])
            prln("  第", i, "个竟然解析成功:", r)
        } catch (e) {
            prln("  第", i, "个被拒绝:", e.msg)
        }
        i += 1
    }

    prln("── 6) 文件往返（模块里调用 io 库）──")
    local path = "json_scratch.json"
    local data = {title = "配置文件", nums = {10, 20, 30}, ratio = 0.25, enabled = false}
    prln("写入 =", json.encodeFile(path, data))
    local back = json.decodeFile(path)
    prln("读回 title =", back.title, "| nums[3] =", back.nums[3], "| ratio =", back.ratio)
    prln("深相等 =", equal(data, back))
    io.remove(path)
    prln("清理 =", json.encode(io.isFile(path)) == "false")

    prln("── 7) 中文与 emoji 往返 ──")
    local zh = {msg = "你好，世界！", mark = "★"}
    local enc = json.encode(zh)
    prln("编码 =", enc)
    prln("往返 =", json.decode(enc).msg == zh.msg and json.decode(enc).mark == zh.mark)

    prln("── 8) 嵌套数组 ──")
    local m = json.decode("[[1,2],[3,[4,5]]]")
    prln("m[2][2][1] =", m[2][2][1], "| 重新编码 =", json.encode(m))
}
