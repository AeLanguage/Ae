// 尾随逗号：表字面量允许 `{a = 1,}` / `{1, 2,}`（多行表写起来更顺）
func main() {
    local a = {
        x = 1,
        y = 2,
    }
    local b = {10, 20, 30,}
    local c = {}
    prln(a.x, a.y, len(b), b[3], len(c))

    local d = {
        ["k"] = 9,        // [expr] 键 + 尾随逗号
    }
    prln(d["k"])

    local e = {
        nested = {
            z = 7,
        },
    }
    prln(e.nested.z)
}
