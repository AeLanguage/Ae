// os 库验收：命令行参数 / 环境变量 / 目录 / 时间 / 随机 / 系统信息
imp os

func main() {
    prln("── 命令行 ──")
    local a = os.args()
    prln("argCount =", os.argCount(), "| len(args) =", len(a), "| 内容 =", a)
    prln("scriptPath 非空 =", len(os.scriptPath()) > 0)

    prln("── 环境变量 ──")
    local p = os.getEnv("PATH")
    prln("PATH 存在 =", p != null, "| 长度 > 0 =", len(p) > 0)
    prln("不存在的变量 =", os.getEnv("AE_NO_SUCH_VAR_XYZ"))
    prln("lastError 非空 =", len(os.lastError()) > 0)
    prln("setEnv =", os.setEnv("AE_TEST_VAR", "hello"), "| 回读 =", os.getEnv("AE_TEST_VAR"))
    prln("env() 条目 > 0 =", count(os.env()) > 0)

    prln("── 目录 ──")
    prln("cwd 非空 =", len(os.cwd()) > 0)
    prln("tempDir 非空 =", len(os.tempDir()) > 0)
    prln("homeDir 存在 =", os.homeDir() != null)
    local old = os.cwd()
    prln("chdir 到 tempDir =", os.chdir(os.tempDir()))
    prln("已切换 =", os.cwd() == os.tempDir())
    prln("chdir 回原目录 =", os.chdir(old), "| 已还原 =", os.cwd() == old)
    prln("chdir 到不存在 =", os.chdir("Z:/no/such/dir"), "| lastError 非空 =", len(os.lastError()) > 0)

    prln("── 时间 ──")
    prln("time() 合理 =", os.time() > 1600000000)
    local s = os.formatTime("%Y-%m-%d %H:%M:%S", 1700000000)
    prln("formatTime 长度 =", len(s), "| 年份 =", substr(s, 1, 4))
    local t0 = os.millis()
    os.sleep(30)
    prln("sleep(30) 实际 >= 25ms =", os.millis() - t0 >= 25)
    prln("millis 单调 =", os.millis() >= t0)

    prln("── 随机 ──")
    os.seed(42)
    local r1 = os.random(1000)
    os.seed(42)
    local r2 = os.random(1000)
    prln("同种子可复现 =", r1 == r2, "| 在 0..999 =", r1 >= 0 and r1 < 1000)
    prln("random() 非负 =", os.random() >= 0)
    local f = os.randomFloat()
    prln("randomFloat 在 [0,1) =", f >= 0.0 and f < 1.0)

    prln("── 系统信息 ──")
    prln("platform 合法 =", os.platform() == "windows" or os.platform() == "linux" or os.platform() == "macos")
    prln("pid > 0 =", os.pid() > 0, "| hostname 非空 =", len(os.hostname()) > 0)
    prln("cpuCount > 0 =", os.cpuCount() > 0)
}
