// =============================================================================
//  ui 库手动演示 —— 想亲眼看窗口就跑这个（不会被 run.ps1 当成用例）
//
//  跑法（在 Test 目录下）：
//      ..\Apt\aec.exe ui_demo.ae
//      ..\Apt\ae.exe ui_demo.aeo
//
//  窗口出现后：点右上角 X 关闭（脚本会打印"[+] 窗口都关了"然后退出）
// =============================================================================
imp ui

func main() {
    local id = ui.window("Ae UI 演示", 400, 300)
    if (id == null) {
        prln("[-] 建窗口失败:", ui.lastError())
        return
    }
    prln("[+] 建好窗口 id =", id)
    prln("    客户区 400x300，整窗", ui.info(id).winW, "x", ui.info(id).winH, "（含边框）")

    ui.pos(id, 300, 200)          // 挪到屏幕上好找的地方
    ui.show(id)

    local i = ui.info(id)
    prln("    visible =", i.visible, "| resizable =", i.resizable, "| maximizable =", i.maximizable)
    prln("    点 X 关闭窗口，脚本会退出……")

    ui.run(0)                     // ★ 阻塞在这里转消息循环
    prln("[+] 窗口都关了，脚本退出")
}
